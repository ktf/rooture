{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "rooture",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_expr"
      }
    },
    "_expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "sexpr"
        },
        {
          "type": "SYMBOL",
          "name": "qexpr"
        },
        {
          "type": "SYMBOL",
          "name": "float"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "dot_method"
        },
        {
          "type": "SYMBOL",
          "name": "named_ref"
        },
        {
          "type": "SYMBOL",
          "name": "symbol"
        }
      ]
    },
    "sexpr": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_expr"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "qexpr": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "qexpr_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "qexpr_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "|"
            },
            {
              "type": "SYMBOL",
              "name": "inlinestr"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_expr"
        }
      ]
    },
    "inlinestr": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^}\\n]*"
      }
    },
    "float": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "-?[0-9]+\\.[0-9]*[eE][+-]?[0-9]+"
            },
            {
              "type": "PATTERN",
              "value": "-?[0-9]+\\.[0-9]*"
            },
            {
              "type": "PATTERN",
              "value": "-?\\.[0-9]+[eE][+-]?[0-9]+"
            },
            {
              "type": "PATTERN",
              "value": "-?\\.[0-9]+"
            },
            {
              "type": "PATTERN",
              "value": "-?[0-9]+[eE][+-]?[0-9]+"
            }
          ]
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "-?[0-9]+"
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"([^\"\\\\]|\\\\.)*\""
      }
    },
    "dot_method": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\.[a-zA-Z_][a-zA-Z0-9_]*"
      }
    },
    "named_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "@[a-zA-Z0-9_]+"
      }
    },
    "symbol": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9_+\\-*\\/\\\\=<>!&.:$~?%]+"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": ";[^\\r\\n]*"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}