;;; fit_gui.rut
;;;
;;; Fill a Gaussian histogram with controllable mean and sigma,
;;; then fit it with a user-selected function and report the fit quality.
;;; Includes a TSpline3 smoothing mode with a variable number of control points.
;;;
;;;   (load examples/fit_gui.rut)

(load stdlib.rut)
(.Load gSystem "libGui")
(global "gClient")

;;; ── window ───────────────────────────────────────────────────────────────
(def {win} (new TGMainFrame (.GetRoot gClient) 600 560))

;;; ── canvas ───────────────────────────────────────────────────────────────
(def {ec} (new TRootEmbeddedCanvas "fit_canvas" win 580 340))
(.AddFrame win ec (new TGLayoutHints 65 5 5 5 2))

;;; ── generator controls ───────────────────────────────────────────────────
(def {gen-row} (new TGHorizontalFrame win 580 36))
(.AddFrame win gen-row (new TGLayoutHints 65 5 5 2 2))

(def {mu-lbl} (new TGLabel gen-row "mu = 0.0"))
(.AddFrame gen-row mu-lbl (new TGLayoutHints 36 5 5 4 4))

(def {mu-sl}
  (doto (new TGHSlider gen-row 160 3 -1)
    {SetRange -30 30}
    {SetPosition 0}))
(.AddFrame gen-row mu-sl (new TGLayoutHints 36 2 15 4 4))

(def {sig-lbl} (new TGLabel gen-row "sigma = 1.0"))
(.AddFrame gen-row sig-lbl (new TGLayoutHints 36 5 5 4 4))

(def {sig-sl}
  (doto (new TGHSlider gen-row 160 3 -1)
    {SetRange 1 50}
    {SetPosition 10}))
(.AddFrame gen-row sig-sl (new TGLayoutHints 36 2 5 4 4))

;;; ── entries control ──────────────────────────────────────────────────────
(def {n-row} (new TGHorizontalFrame win 580 36))
(.AddFrame win n-row (new TGLayoutHints 65 5 5 2 2))

(def {n-lbl} (new TGLabel n-row "N = 10000"))
(.AddFrame n-row n-lbl (new TGLayoutHints 36 5 5 4 4))

(def {n-sl}
  (doto (new TGHSlider n-row 300 3 -1)
    {SetRange 1 100}
    {SetPosition 100}))
(.AddFrame n-row n-sl (new TGLayoutHints 36 2 5 4 4))

;;; ── control points row (visible only when "spline" is selected) ──────────
(def {npts-row} (new TGHorizontalFrame win 580 36))
(.AddFrame win npts-row (new TGLayoutHints 65 5 5 2 2))

(def {npts-lbl} (new TGLabel npts-row "Control pts: 5"))
(.AddFrame npts-row npts-lbl (new TGLayoutHints 36 5 5 4 4))

(def {npts-sl}
  (doto (new TGHSlider npts-row 200 3 -1)
    {SetRange 3 20}
    {SetPosition 5}))
(.AddFrame npts-row npts-sl (new TGLayoutHints 36 2 5 4 4))

;;; ── fit controls ─────────────────────────────────────────────────────────
(def {fit-row} (new TGHorizontalFrame win 580 36))
(.AddFrame win fit-row (new TGLayoutHints 65 5 5 2 2))

(.AddFrame fit-row (new TGLabel fit-row "Fit function:") (new TGLayoutHints 18 5 5 4 4))

(def {combo}
  (doto (new TGComboBox fit-row -1)
    {AddEntry "gaus" 0}
    {AddEntry "pol1" 1}
    {AddEntry "pol2" 2}
    {AddEntry "pol3" 3}
    {AddEntry "smooth" 4}
    {Resize 90 22}
    {Select 0}))
(.AddFrame fit-row combo (new TGLayoutHints 18 2 15 2 2))

(def {fit-btn} (new TGTextButton fit-row "  Fit  " -1))
(.AddFrame fit-row fit-btn (new TGLayoutHints 18 5 5 2 2))

(def {res-lbl} (new TGLabel fit-row "chi2 = —       ndf = —"))
(.AddFrame fit-row res-lbl (new TGLayoutHints 18 15 5 4 4))

;;; ── ROOT objects ─────────────────────────────────────────────────────────
(def {canvas} (.GetCanvas ec))
(def {h}  (new TH1F "fh" "Gaussian data;x;entries" 100 -10. 10.))
(.SetDirectory h 0)
(def {gf} (new TF1 "gfunc" "gaus" -10. 10.))

;;; ── redraw: update labels, refill histogram ──────────────────────────────
(def {redraw} (\{} {do
  (= {mu}       (/ (.GetPosition mu-sl)  10.))
  (= {sigma}    (/ (.GetPosition sig-sl) 10.))
  (= {nentries} (* (.GetPosition n-sl) 100))
  (.SetText mu-lbl  (new TGString (concat "mu = "    (str mu))))
  (.SetText sig-lbl (new TGString (concat "sigma = " (str sigma))))
  (.SetText n-lbl   (new TGString (concat "N = "     (str nentries))))
  (doto gf {SetParameters 1. mu sigma})
  (doto h {Reset} {FillRandom gf nentries})
  (.cd canvas)
  (.Draw h "HIST")
  (.Modified canvas)}))

;;; ── spline smoothing ─────────────────────────────────────────────────────
;;; Sample the histogram at N evenly-spaced x positions, build a TGraph,
;;; and draw a TSpline3 through those points.  Pure rooture — no ProcessLine.
(def {do-spline} (\{} {do
  (= {n}    (.GetPosition npts-sl))
  (= {xmin} -10.)
  (= {xmax}   10.)
  (= {gr} (new TGraph n))
  (dotimes {i} n {do
    (= {x} (+ xmin (/ (* i (- xmax xmin)) (- n 1))))
    (.SetPoint gr i x (.GetBinContent h (.FindBin h x)))})
  (= {sp} (new TSpline3 "spline" gr))
  (.SetText res-lbl
    (new TGString (concat "Spline (" (str n) " pts)")))
  (.cd canvas)
  (.Draw h "HIST")
  (.Draw sp "same")
  (.Modified canvas)}))

;;; ── fit callback ─────────────────────────────────────────────────────────
(def {do-fit} (\{} {do
  (= {sel} (.GetSelected combo))
  (if (== sel 4.)
    {do-spline}
    {do
      (= {fname} (if (== sel 0.) {"gaus"}
                 {(if (== sel 1.) {"pol1"}
                 {(if (== sel 2.) {"pol2"}
                 {"pol3"})})}))
      (.Fit h fname "Q")
      (= {fn} (.GetFunction h fname))
      (.SetText res-lbl
        (new TGString (concat "chi2 = " (str (.GetChisquare fn))
                              "  ndf = " (str (.GetNDF fn)))))
      (.cd canvas)
      (.Draw h "HIST")
      (.Draw fn "SAME")
      (.Modified canvas)})}))

;;; ── combo → show/hide the control-points row ─────────────────────────────
(def {on-combo-change} (\{id} {do
  (if (== id 4.)
    {do (.ShowFrame win npts-row) (.Layout win)}
    {do (.HideFrame win npts-row) (.Layout win)})}))

;;; ── npts slider label update ─────────────────────────────────────────────
(connect npts-sl "PositionChanged(Int_t)"
  (\{} {do
    (.SetText npts-lbl
      (new TGString (concat "Control pts: " (str (.GetPosition npts-sl)))))}))

(connect mu-sl   "PositionChanged(Int_t)" redraw)
(connect sig-sl  "PositionChanged(Int_t)" redraw)
(connect n-sl    "PositionChanged(Int_t)" redraw)
(connect fit-btn "Clicked()" do-fit)
(connect combo   "Selected(Int_t)" on-combo-change)

;;; ── build and show window ────────────────────────────────────────────────
(.HideFrame win npts-row)

(doto win
  {SetWindowName "Gaussian Fit GUI"}
  {MapSubwindows}
  {Resize (.GetDefaultWidth win) (.GetDefaultHeight win)}
  {MapRaised})

(redraw)
