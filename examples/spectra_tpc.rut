;;; examples/spectra_tpc.rut
;;;
;;; TPC pT spectrum with DCA-to-PV track propagation.
;;;
;;; Implements O2 TrackParametrization::propagateParamToDCA as a col-jit-fn,
;;; gathering primary-vertex coordinates per track from O2collision_001.
;;;
;;; The propagation is a literal translation of the O2 algorithm:
;;;   1. rotateParam(alpha + asin(sn2))  — re-express track in frame aligned with vertex
;;;   2. propagateParamTo(xv, b)         — advance track to vertex x position
;;;   3. dca = (getY() - yv, getZ() - zv)
;;; Derived closed-form (dx_propagate = -x2):
;;;   dcaXY = y2 - x2 * dy2dx
;;;   dcaZ  = fZ + dz - pvZ
;;;
;;; Cuts:
;;;   nCls (found TPC clusters) >= 70
;;;   |dcaXY| < 0.0105 + 0.035/pT^1.1 cm  (pT-parameterised, matches isGlobalTrack)
;;;   |dcaZ|  < 2.0 cm
;;;
;;; Usage:
;;;   (load "examples/spectra_tpc.rut")

(load stdlib.rut)
(load examples/jit_progress.rut)
(default {raa-mode} 0)   ;;; set to 1 before loading to skip tf-scan + spectra analysis

;;; aod-paths must be set before loading, e.g.:
;;;   (def {aod-paths} (list "/path/to/AO2D.root"))
;;;   (def {aod-paths} (list "/path/1.root" "/path/2.root"))
;;;
;;; Guard: abort with a clear message if aod-paths was not defined.
;;; (When undefined, the symbol auto-converts to the string "aod-paths".)
(if (== aod-paths "aod-paths") {
  do
  (print "ERROR: aod-paths must be defined before loading spectra_tpc.rut.")
  (print "  Example: (def {aod-paths} (list \"/tmp/AO2D.root\"))")
  (print "  For Run2 files also set: trk-tree extra-tree coll-tree bc-tree")
  (def {aod-paths} {})
} {})

;;; Tree name defaults (Run3). For Run2-converted files use:
;;;   O2track  O2trackextra  O2collision  O2bc
;;; If set before loading, those values are kept; otherwise defaults apply.
(default {trk-tree}   "O2track_iu")
(default {extra-tree} "O2trackextra_002")
(default {coll-tree}  "O2collision_001")
(default {bc-tree}    "O2bc_001")
(default {bz} 0.5)   ;;; solenoid field in Tesla

;;; ITS cluster branch name:
;;;   "fITSClusterMap"   — Run2 local files (uint8 bitmask, 1 bit per layer)
;;;   "fITSClusterSizes" — Open Data / newer AO2D (packed nibbles, 4 bits per layer)
;;; Both: nonzero ↔ has ITS hit — the its-ok-fn check (> itsmap 0.5f) works for both.
(default {its-map-branch} "fITSClusterMap")

;;; ── Event selection parameters ───────────────────────────────────────────
;;; Set bcSOR = 0 to disable TF/ITS ROF border checks (pass all).
;;; Set to the actual first-BC-of-run value from the run CCDB page to enable.
(default {bcSOR}     0)
(default {nBCsPerTF} 456192)   ;;; 128 * 3564 (Run 3)
(default {rofLength} 594)      ;;; ITS ROF length in BCs (Run 3)
(default {rofOffset} 0)
(default {tvx-bit}   -1)      ;;; -1 = skip TVX (fTriggerMask not filled in all datasets)
(default {pvz-cut}   10.0)
(load examples/eventsel.rut)
(load examples/tracksel.rut)

;;; ── Optional: fetch BB parameters from CCDB ─────────────────────────────
;;; Set ccdb-pid-ts to any Unix timestamp in ms (or 1 to use CCDB's default).
;;; When 0 (default), pid_tpc.rut's built-in defaults are used.
;;; Set ccdb-pid-url to your CCDB proxy (e.g. "http://localhost:8888").
;;; Set ccdb-pid-headers to a list of HTTP headers if auth is needed.
;;; Example:
;;;   (def {ccdb-pid-ts}      1)
;;;   (def {ccdb-pid-url}     "http://localhost:8888")
;;;   (def {ccdb-pid-headers} {"Authorization: Bearer test123"})
;;;   (load "examples/spectra_tpc.rut")
(default {ccdb-pid-ts}      0)
(default {ccdb-pid-url}     "http://localhost:8888")
(default {ccdb-pid-headers} {})
(if (> ccdb-pid-ts 0)
  {do
    (print "Fetching TPC BB params from CCDB for ts=" ccdb-pid-ts)
    (= {_bb-url} (concat ccdb-pid-url "/Analysis/PID/TPC/BetheBloch/" (str ccdb-pid-ts)))
    (= {_bb-f}   (deref (fetch-url _bb-url ccdb-pid-headers)))
    (= {_bb-obj} (tfile-get _bb-f "ccdb_object"))
    ;;; mPar = {kp1 kp2 kp3 kp4 kp5 mMIP resolution}
    ;;; pid_tpc.rut absorbs mMIP into bb0: bb0 = mMIP * kp1
    (= {_par}    (tobj-member _bb-obj "mPar"))
    (def {bb0}   (* (nth 5 _par) (nth 0 _par)))
    (def {bb1}   (nth 1 _par))
    (def {bb2}   (nth 2 _par))
    (def {bb3}   (nth 3 _par))
    (def {bb4}   (nth 4 _par))
    (def {bb-res} (/ (nth 6 _par) (nth 5 _par)))
    (print "CCDB BB params: bb0=" bb0 "bb1=" bb1 "bb2=" bb2
           "bb3=" bb3 "bb4=" bb4 "bb-res=" bb-res)}
  {})
(load examples/pid_tpc.rut)

;;; ── Collect {path tf-name} pairs across all input files ─────────────────
;;; Skipped in raa-mode=1 (raa_pbpb.rut scans files inline, one at a time).
(if (== raa-mode 0)
  {do
    (.SetValue gEnv "XNet.RequestTimeout" 30)
    (.SetValue gEnv "XNet.ConnectTimeout" 10)
    (def {tf-pairs} (do
      (= {acc} {})
      (dotimes {pi} (len aod-paths) {
        do
        (= {path} (nth pi aod-paths))
        (print "Opening file" (+ pi 1) "/" (len aod-paths) ":" path)
        (= {f} (::Open TFile path))
        (if (== f 0)
          {print "WARNING: could not open" path "(skipping)"}
          {if (.IsZombie f)
            {print "WARNING: zombie file" path "(skipping)"}
            {do
              (= {keys} (.GetListOfKeys f))
              (dotimes {i} (.GetEntries keys) {
                do
                (= {k} (.At keys i))
                (if (== (.GetClassName k) "TDirectoryFile")
                  {= {acc} (join acc (list (list path (.GetName k))))}
                  {})
              })}})
      })
      acc))
    (print "Timeframes:" (len tf-pairs) "across" (len aod-paths) "file(s)")
  }
  {do
    (.SetValue gEnv "XNet.RequestTimeout" 30)
    (.SetValue gEnv "XNet.ConnectTimeout" 10)
    (def {tf-pairs} {})})

;;; ── Auxiliary jit-fns ────────────────────────────────────────────────────

(def {pt-ptr}
  (jitfn! "pt" float (\{{float s1pt}}
    {(if (== s1pt 0.0f) {0.0f} {(/ 1.0f (fabsf s1pt))})})))

;;; total momentum p = sqrt(1 + tgl²) / |q/pT|
(def {p-ptr}
  (jitfn! "p" float (\{{float s1pt} {float tgl}}
    {(if (== s1pt 0.0f) {0.0f}
      {(/ (sqrtf (+ 1.0f (* tgl tgl))) (fabsf s1pt))})})))

;;; η = asinh(tgl); mask: |η| < 0.8
;;; ── Spectra analysis ────────────────────────────────────────────────────
;;; Call (run) to execute. Skipped automatically when raa-mode=1.
(fun {run} {do
(if (== raa-mode 1) {} {do

;;; ── Histograms — pre-created on main thread ──────────────────────────────

;;; Per-TF histograms (keyed by index; TF dir names are unique timestamps)
(def {tf-hpt}  (map (\ {pr} {doto (new TH1F (concat "pt_"  (nth 1 pr)) "" 100 0. 20.) {SetDirectory 0}}) tf-pairs))
(def {tf-hp}   (map (\ {pr} {doto (new TH1F (concat "p_"   (nth 1 pr)) "" 100 0. 20.) {SetDirectory 0}}) tf-pairs))
(def {tf-hdxy} (map (\ {pr} {doto (new TH1F (concat "dxy_" (nth 1 pr)) "" 100 -5. 5.) {SetDirectory 0}}) tf-pairs))
(def {tf-hdz}  (map (\ {pr} {doto (new TH1F (concat "dz_"  (nth 1 pr)) "" 100 -5. 5.) {SetDirectory 0}}) tf-pairs))
(def {tf-hvz}  (map (\ {pr} {doto (new TH1F (concat "vz_"  (nth 1 pr)) "" 100 -20. 20.) {SetDirectory 0}}) tf-pairs))

;;; Per-TF stopwatches for timing (pre-created on main thread; safe in pmap)
(def {tf-sws-tot}  (map (\ {_} {new TStopwatch}) tf-pairs))
(def {tf-sws-read} (map (\ {_} {new TStopwatch}) tf-pairs))

;;; Global merged histograms
(def {h-pt}
  (doto (new TH1F "hpt" ";p_{T} (GeV/c);Tracks" 100 0. 20.) {SetDirectory 0}))
(def {h-p}
  (doto (new TH1F "hp" ";p (GeV/c);Tracks" 100 0. 20.) {SetDirectory 0}))
(def {h-dcaxy}
  (doto (new TH1F "hdcaxy" ";DCA_{XY} (cm);Tracks" 100 -5. 5.) {SetDirectory 0}))
(def {h-dcaz}
  (doto (new TH1F "hdcaz" ";DCA_{Z} (cm);Tracks" 100 -5. 5.) {SetDirectory 0}))
(def {h-vz}
  (doto (new TH1F "hvz" ";Vertex Z (cm);Collisions" 100 -20. 20.) {SetDirectory 0}))

;;; Per-species histograms (El Mu Pi Ka Pr De)
(def {species-names} (list "El" "Mu" "Pi" "Ka" "Pr" "De"))
(def {h-pt-species} (map (\ {s} {
  doto (new TH1F (concat "hpt_" s) (concat s ";p_{T} (GeV/c);Tracks") 100 0. 20.)
    {SetDirectory 0}
}) species-names))
(def {h-p-species}  (map (\ {s} {
  doto (new TH1F (concat "hp_" s) (concat s ";p (GeV/c);Tracks") 100 0. 20.)
    {SetDirectory 0}
}) species-names))
;;; Per-TF species histograms: tf-hpt-sp / tf-hp-sp — list of 6 lists (one per species)
(def {tf-hpt-sp} (map (\ {s} {
  map (\ {pr} {doto (new TH1F (concat "pt_" s "_" (nth 1 pr)) "" 100 0. 20.) {SetDirectory 0}}) tf-pairs
}) species-names))
(def {tf-hp-sp} (map (\ {s} {
  map (\ {pr} {doto (new TH1F (concat "p_" s "_" (nth 1 pr)) "" 100 0. 20.) {SetDirectory 0}}) tf-pairs
}) species-names))

;;; ── Canvas: 5 pads ───────────────────────────────────────────────────────
(def {c} (new TCanvas "c_spectra" "TPC spectra" 1800 400))
(def {p1} (doto (new TPad "p1" "" 0.0  0. 0.2 1.) {SetLogy} {Draw}))
(def {p2} (doto (new TPad "p2" "" 0.2  0. 0.4 1.) {SetLogy} {Draw}))
(def {p3} (doto (new TPad "p3" "" 0.4  0. 0.6 1.) {Draw}))
(def {p4} (doto (new TPad "p4" "" 0.6  0. 0.8 1.) {Draw}))
(def {p5} (doto (new TPad "p5" "" 0.8  0. 1.0 1.) {Draw}))

;;; ── Process all timeframes ────────────────────────────────────────────────
(def {sw} (doto (new TStopwatch) {Start}))

(pmap (\ {i} {
  do
  (= {pr}   (nth i tf-pairs))
  (= {aod-path} (nth 0 pr))
  (= {tf}   (nth 1 pr))
  (= {hpt}  (nth i tf-hpt))
  (= {hp}   (nth i tf-hp))
  (= {hdxy} (nth i tf-hdxy))
  (= {hdz}  (nth i tf-hdz))
  (= {hvz}  (nth i tf-hvz))
  (print "  TF" (+ i 1) "/" (len tf-pairs) tf)
  (= {sw-tot}  (nth i tf-sws-tot))
  (= {sw-read} (nth i tf-sws-read))
  (.Start sw-tot)
  (.Start sw-read)

  ;;; track parameters in local alpha frame
  (= {fx-c}   (load-branch aod-path (concat tf "/" trk-tree) "fX"))
  (= {fy-c}   (load-branch aod-path (concat tf "/" trk-tree) "fY"))
  (= {fz-c}   (load-branch aod-path (concat tf "/" trk-tree) "fZ"))
  (= {snp-c}  (load-branch aod-path (concat tf "/" trk-tree) "fSnp"))
  (= {tgl-c}  (load-branch aod-path (concat tf "/" trk-tree) "fTgl"))
  (= {q1pt-c} (load-branch aod-path (concat tf "/" trk-tree) "fSigned1Pt"))
  (= {alp-c}  (load-branch aod-path (concat tf "/" trk-tree) "fAlpha"))
  (= {cidx-c} (load-branch aod-path (concat tf "/" trk-tree) "fIndexCollisions"))

  ;;; extra: findable, (findable-found), TPC signal, inner-wall momentum, and global track cuts
  (= {find-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindable"))
  (= {fmin-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindableMinusFound"))
  (= {fcrows-c}  (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindableMinusCrossedRows"))
  (= {sig-c}     (load-branch aod-path (concat tf "/" extra-tree) "fTPCSignal"))
  (= {pinner-c}  (load-branch aod-path (concat tf "/" extra-tree) "fTPCInnerParam"))
  (= {itsmap-c}  (load-branch aod-path (concat tf "/" extra-tree) its-map-branch))
  (= {itschi2-c} (load-branch aod-path (concat tf "/" extra-tree) "fITSChi2NCl"))
  (= {tpcchi2-c} (load-branch aod-path (concat tf "/" extra-tree) "fTPCChi2NCl"))
  (= {tofchi2-c} (load-branch aod-path (concat tf "/" extra-tree) "fTOFChi2"))
  (= {tofp-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTOFExpMom"))
  (= {length-c}  (load-branch aod-path (concat tf "/" extra-tree) "fLength"))
  (= {time-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTrackTime"))
  (= {timeres-c} (load-branch aod-path (concat tf "/" extra-tree) "fTrackTimeRes"))

  ;;; collision vertex
  (= {pvxc-c} (load-branch aod-path (concat tf "/" coll-tree) "fPosX"))
  (= {pvyc-c} (load-branch aod-path (concat tf "/" coll-tree) "fPosY"))
  (= {pvzc-c} (load-branch aod-path (concat tf "/" coll-tree) "fPosZ"))

  ;;; per-collision event selection mask (TVX + TF border + ITS ROF + pvZ + no-pileup)
  (= {evsel-cols} (compute-evsel-tf aod-path tf))
  (= {evsel-col}  (evsel-and evsel-cols))
  (.Stop sw-read)   ;;; read phase ends here

  ;;; vertex Z: fill only selected collisions (after event selection, matches official)
  (col-fill-h1 hvz (col-mask evsel-col pvzc-c))

  ;;; gather PV position and event-sel mask to per-track using fIndexCollisions
  (= {pvX-c}    (col-gather pvxc-c    cidx-c))
  (= {pvY-c}    (col-gather pvyc-c    cidx-c))
  (= {pvZ-c}    (col-gather pvzc-c    cidx-c))
  (= {m-ev}     (col-gather evsel-col cidx-c))

  ;;; compute DCA → {dcaXY, dcaZ}
  (= {dca}     (propagate-to-dca
                  fx-c fy-c fz-c snp-c tgl-c q1pt-c alp-c
                  pvX-c pvY-c pvZ-c))
  (= {dcaxy-c} (nth 0 dca))
  (= {dcaz-c}  (nth 1 dca))

  ;;; nCls = fTPCNClsFindable - fTPCNClsFindableMinusFound
  ;;; nCrossedRows = fTPCNClsFindable - fTPCNClsFindableMinusCrossedRows
  (= {ncls-c}   (col-zip-ptr sub-ptr (col-cast-f32 find-c) (col-cast-f32 fmin-c)))
  (= {ncrows-c} (col-zip-ptr sub-ptr (col-cast-f32 find-c) (col-cast-f32 fcrows-c)))
  (= {pt-c}     (col-map-ptr pt-ptr q1pt-c))
  (= {p-c}      (col-zip-ptr p-ptr q1pt-c tgl-c))
  (= {m-eta}    (col-map-ptr eta-ok-ptr tgl-c))

  ;;; quality mask: event sel AND eta AND nCls AND DCA AND global track cuts
  (= {m-cls}   (col-map-ptr cls-ok-ptr ncls-c))
  (= {m-its}   (col-zip-ptr its-ok-ptr (col-cast-f32 itsmap-c) (col-cast-f32 itschi2-c)))
  (= {m-tpcq}  (col-map-ptr tpcchi2-ok-ptr (col-cast-f32 tpcchi2-c)))
  (= {m-crows} (col-zip-ptr crows-ok-ptr ncrows-c (col-cast-f32 find-c)))
  (= {m-dca}   (col-zip-ptr dca-ok-ptr dcaxy-c dcaz-c pt-c))
  (= {mask}    (col-and m-ev m-eta m-cls m-dca m-its m-tpcq m-crows))

  ;;; fill histograms
  (col-fill-h1 hpt  (col-mask mask pt-c))
  (col-fill-h1 hp   (col-mask mask p-c))
  (col-fill-h1 hdxy (col-mask mask dcaxy-c))
  (col-fill-h1 hdz  (col-mask mask dcaz-c))

  ;;; per-species: compute pid masks then combine with quality mask
  (= {pmasks} (pid-masks sig-c p-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c))
  (= {msk-el} (col-and mask (nth 0 pmasks)))
  (= {msk-mu} (col-and mask (nth 1 pmasks)))
  (= {msk-pi} (col-and mask (nth 2 pmasks)))
  (= {msk-ka} (col-and mask (nth 3 pmasks)))
  (= {msk-pr} (col-and mask (nth 4 pmasks)))
  (= {msk-de} (col-and mask (nth 5 pmasks)))
  (col-fill-h1 (nth i (nth 0 tf-hpt-sp)) (col-mask msk-el pt-c))
  (col-fill-h1 (nth i (nth 1 tf-hpt-sp)) (col-mask msk-mu pt-c))
  (col-fill-h1 (nth i (nth 2 tf-hpt-sp)) (col-mask msk-pi pt-c))
  (col-fill-h1 (nth i (nth 3 tf-hpt-sp)) (col-mask msk-ka pt-c))
  (col-fill-h1 (nth i (nth 4 tf-hpt-sp)) (col-mask msk-pr pt-c))
  (col-fill-h1 (nth i (nth 5 tf-hpt-sp)) (col-mask msk-de pt-c))
  (col-fill-h1 (nth i (nth 0 tf-hp-sp))  (col-mask msk-el p-c))
  (col-fill-h1 (nth i (nth 1 tf-hp-sp))  (col-mask msk-mu p-c))
  (col-fill-h1 (nth i (nth 2 tf-hp-sp))  (col-mask msk-pi p-c))
  (col-fill-h1 (nth i (nth 3 tf-hp-sp))  (col-mask msk-ka p-c))
  (col-fill-h1 (nth i (nth 4 tf-hp-sp))  (col-mask msk-pr p-c))
  (col-fill-h1 (nth i (nth 5 tf-hp-sp))  (col-mask msk-de p-c))

  (.Stop sw-tot)
  (close-cached-files)   ;;; free TFile handles to cap per-thread memory usage
}) (do
  (= {acc} {})
  (dotimes {i} (len tf-pairs) {= {acc} (join acc (list i))})
  acc))

(.Stop sw)

;;; ── Merge per-TF histograms ──────────────────────────────────────────────
(map (\ {h} {.Add h-pt    h}) tf-hpt)
(map (\ {h} {.Add h-p     h}) tf-hp)
(map (\ {h} {.Add h-dcaxy h}) tf-hdxy)
(map (\ {h} {.Add h-dcaz  h}) tf-hdz)
(map (\ {h} {.Add h-vz    h}) tf-hvz)
(dotimes {s} 6 {
  do
  (map (\ {h} {.Add (nth s h-pt-species) h}) (nth s tf-hpt-sp))
  (map (\ {h} {.Add (nth s h-p-species)  h}) (nth s tf-hp-sp))
})

(def {n-sel}  (.GetEntries h-pt))
(def {wall-s} (.RealTime sw))
(print "Selected tracks:" n-sel "  wall time:" wall-s "s")

;;; ── Per-TF timing histograms ─────────────────────────────────────────────
(def {h-tf-time}   (doto (new TH1F "h_tf_time"   ";Wall time per TF (s);TFs" 60 0. 30.) {SetDirectory 0}))
(def {h-read-time} (doto (new TH1F "h_read_time"  ";Read time per TF (s);TFs" 60 0. 30.) {SetDirectory 0}))
(map (\ {sw} {.Fill h-tf-time   (.RealTime sw)}) tf-sws-tot)
(map (\ {sw} {.Fill h-read-time (.RealTime sw)}) tf-sws-read)

;;; ── Draw ─────────────────────────────────────────────────────────────────
;;; pad 1: pT spectrum (log y)
(.cd p1)
(doto h-pt {SetLineColor 4} {Draw})
;;; pad 2: p spectrum (log y)
(.cd p2)
(doto h-p {SetLineColor 2} {Draw})
;;; pad 3: vertex Z
(.cd p3)
(doto h-vz {SetLineColor 1} {Draw})
;;; pad 4: DCA_XY
(.cd p4)
(doto h-dcaxy {SetLineColor 4} {Draw})
;;; pad 5: DCA_Z
(.cd p5)
(doto h-dcaz {SetLineColor 2} {Draw})
(.Update c) (.RaiseWindow c)

;;; ── Timing canvas ────────────────────────────────────────────────────────
(def {c-timing} (new TCanvas "c_timing" "Per-TF timing" 900 400))
(.Divide c-timing 2 1)
(.cd c-timing 1)
(doto h-tf-time   {SetLineColor 4} {SetLineWidth 2} {Draw "HIST"})
(.cd c-timing 2)
(doto h-read-time {SetLineColor 2} {SetLineWidth 2} {Draw "HIST"})
(.Update c-timing)

}) ;;; end raa-mode check
}) ;;; end run

(provide {run tf-pairs propagate-to-dca
          h-pt h-p h-pt-species h-p-species
          h-dcaxy h-dcaz h-vz
          bb0 bb1 bb2 bb3 bb4 bb-res
          pid-masks flat-dca-mode})
