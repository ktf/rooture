;;; examples/pid_nuclei.rut
;;;
;;; TPC + TOF PID for Z=2 light nuclei: ³He and ⁴He (and their anti-particles).
;;;
;;; Physics:
;;;   The TPC signal for a charge-Z nucleus is Z²×BB(βγ), where βγ = p_rig/m
;;;   and p_rig is the magnetic rigidity = p/|Z|.  The tracker reconstructs
;;;   rigidity and stores it as if Z=1, so fSigned1Pt = 1/p_rig_T and the
;;;   tracking momentum equals p_rig (not the full physical momentum p = Z×p_rig).
;;;
;;;   Anti-nuclei: fSigned1Pt < 0 (negative curvature).
;;;
;;;   For TOF: fTOFExpMom stores the rigidity at the TOF surface, so the actual
;;;   momentum used in the expected-time formula must be multiplied by Z=2.
;;;
;;; Requires pid_tpc.rut to have been loaded (for bb0..bb4, bb-res, nsigma-max, tof-c,
;;; tof-ok-ptr, and pid-m-* mass constants).
;;;
;;; Usage:
;;;   (load "examples/pid_tpc.rut")          ;;; or load after setting CCDB params
;;;   (load "examples/pid_nuclei.rut")
;;;   ;;; per time-frame:
;;;   (= {masks} (pid-nuclei-masks sig-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c))
;;;   (= {he3-mask} (nth 0 masks))
;;;   (= {he4-mask} (nth 1 masks))
;;;   ;;; continuous nσ for plots / sideband studies:
;;;   (= {nsig-he3-c} (col-zip-ptr nsig-tpc-he3-ptr sig-c pinner-c))

(load stdlib.rut)
(load examples/pid_tpc.rut)

;;; ── Nuclei masses (GeV/c²) ───────────────────────────────────────────────
(def {pid-m-he3} 2.80892)    ;;; ³He nucleus
(def {pid-m-he4} 3.72738)    ;;; ⁴He nucleus (alpha particle)

;;; ── He3 dedicated BB parametrisation ────────────────────────────────────
;;;
;;; From O2Physics NucleiTask / HeNucleiTask:
;;;   double bb(bg, kp1, kp2, kp3, kp4, kp5) {
;;;     beta = bg/sqrt(1+bg²);  aa = beta^kp4;
;;;     return (kp2 - aa - log(kp3 + (1/bg)^kp5)) * kp1 / aa; }
;;;   bbHe3(mom) = bb(mom/2.80839, -321.34, 0.6539, 1.591, 0.8225, 2.363)
;;;
;;; Input: mom = ACTUAL momentum = Z × rigidity = 2 × fTPCInnerParam.
;;; This gives ~260 a.u. at minimum ionising (bg >> 1) for He3 (Z²=4 × ~65).
;;; Resolution: reuses bb-res from pid_tpc.rut (CCDB general value ~0.046).
;;;
;;; He4: no dedicated parametrisation available; falls back to Z²×proton BB.

;;; ── He3 dedicated BB parametrisation (inlined into each jit-fn) ─────────
;;;
;;; From O2Physics NucleiTask:
;;;   bbHe3(mom) = bb(mom/2.80839, -321.34, 0.6539, 1.591, 0.8225, 2.363)
;;;   where bb(bg, kp1..5): beta=bg/sqrt(1+bg²); aa=beta^kp4;
;;;         result = (kp2 - aa - log(kp3 + (1/bg)^kp5)) * kp1 / aa
;;; Input mom = actual He3 momentum = 2 × fTPCInnerParam (Z × rigidity).
;;; Gives ~260 a.u. at minimum ionising. Resolution: bb-res from pid_tpc.rut.
;;;
;;; He4: no dedicated parametrisation; uses Z²×proton BB (may have offset).

;;; Standalone expected-signal function (for BB curve overlays etc.)
(def {bb-he3-fn}
  (jit-fn float (\{{float mom}}
    {do
      (= {bg}   (/ mom 2.80839f))
      (= {safe} (> bg 0.05f))
      (= {bg_s} (if safe {bg} {1.0f}))
      (= {beta} (/ bg_s (sqrtf (+ 1.0f (* bg_s bg_s)))))
      (= {aa}   (powf beta 0.8225f))
      (= {lnt}  (logf (+ 1.591f (powf (/ 1.0f bg_s) 2.363f))))
      (if safe
        {(/ (* (- (- 0.6539f aa) lnt) (- 0.0f 321.34f)) aa)}
        {9999.0f})})))

;;; ── TPC nσ — continuous values ───────────────────────────────────────────
;;; pinner = fTPCInnerParam = rigidity = p_actual/Z.
;;; He3: actual momentum = 2 × pinner; dedicated BB used (formula inlined).
;;; He4: actual momentum = 2 × pinner; falls back to Z²×proton BB.
;;; Returns 9999.0 when BB kinematics are outside the safe range.

(def {nsig-tpc-he3-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}   (/ (* 2.0f pinner) 2.80839f))
      (= {safe} (> bg 0.05f))
      (= {bg_s} (if safe {bg} {1.0f}))
      (= {beta} (/ bg_s (sqrtf (+ 1.0f (* bg_s bg_s)))))
      (= {aa}   (powf beta 0.8225f))
      (= {lnt}  (logf (+ 1.591f (powf (/ 1.0f bg_s) 2.363f))))
      (= {exp_} (if safe
        {(/ (* (- (- 0.6539f aa) lnt) (- 0.0f 321.34f)) aa)}
        {9999.0f}))
      (= {sigma} (* bb-res exp_))
      (if (> exp_ 1.0f) {(/ (- sig exp_) sigma)} {9999.0f})})))

(def {nsig-tpc-he4-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}    (/ pinner pid-m-he4))
      (= {safe}  (> bg 0.05))
      (= {bg_s}  (if safe {bg}   {1.0}))
      (= {beta}  (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}    (pow beta bb3))
      (= {lnt}   (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}  (if safe {(* 4.0 (/ (* (- (- bb1 aa) lnt) bb0) aa))} {9999.0}))
      (= {sigma} (* bb-res exp_))
      (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0})})))

;;; ── TPC PID masks ────────────────────────────────────────────────────────
;;; Returns 1.0 if |nσ_TPC| < nsigma-max, else 0.0.

(def {pid-he3-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}   (/ (* 2.0f pinner) 2.80839f))
      (= {safe} (> bg 0.05f))
      (= {bg_s} (if safe {bg} {1.0f}))
      (= {beta} (/ bg_s (sqrtf (+ 1.0f (* bg_s bg_s)))))
      (= {aa}   (powf beta 0.8225f))
      (= {lnt}  (logf (+ 1.591f (powf (/ 1.0f bg_s) 2.363f))))
      (= {exp_} (if safe
        {(/ (* (- (- 0.6539f aa) lnt) (- 0.0f 321.34f)) aa)}
        {9999.0f}))
      (= {sigma} (* bb-res exp_))
      (= {nsig}  (if (> exp_ 1.0f) {(/ (- sig exp_) sigma)} {9999.0f}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-he4-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}    (/ pinner pid-m-he4))
      (= {safe}  (> bg 0.05))
      (= {bg_s}  (if safe {bg}   {1.0}))
      (= {beta}  (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}    (pow beta bb3))
      (= {lnt}   (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}  (if safe {(* 4.0 (/ (* (- (- bb1 aa) lnt) bb0) aa))} {9999.0}))
      (= {sigma} (* bb-res exp_))
      (= {nsig}  (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

;;; ── Function pointers ────────────────────────────────────────────────────
(def {nsig-tpc-he3-ptr} (jitfn-ptr nsig-tpc-he3-fn))
(def {bb-he3-ptr}       (jitfn-ptr bb-he3-fn))
(def {nsig-tpc-he4-ptr} (jitfn-ptr nsig-tpc-he4-fn))
(def {pid-he3-ptr}      (jitfn-ptr pid-he3-fn))
(def {pid-he4-ptr}      (jitfn-ptr pid-he4-fn))

;;; ── TOF expected times for He3/He4 ──────────────────────────────────────
;;; Input p = fTOFExpMom = rigidity at TOF surface.
;;; Actual momentum = Z × p_rig = 2 × p.

(def {tof-texp-he3-fn}
  (jit-fn float (\{{float p} {float length}}
    {do
      (= {pa}   (* 2.0 p))
      (= {bg}   (/ pa pid-m-he3))
      (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
      (/ length (* beta tof-c))})))

(def {tof-texp-he4-fn}
  (jit-fn float (\{{float p} {float length}}
    {do
      (= {pa}   (* 2.0 p))
      (= {bg}   (/ pa pid-m-he4))
      (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
      (/ length (* beta tof-c))})))

(def {tof-texp-he3-ptr} (jitfn-ptr tof-texp-he3-fn))
(def {tof-texp-he4-ptr} (jitfn-ptr tof-texp-he4-fn))

;;; ── TOF mass² ────────────────────────────────────────────────────────────
;;; mass² = p_actual² × (1/β² − 1) = (2×p_rig)² × ((t×c/L)² − 1)
;;; Returns −999.0 for tracks with no TOF hit (chi2 < 0).
;;; Use for candidate mass-hypothesis plots; the Z=2 mass² for He4 ≈ 13.9 (GeV/c²)².

(def {mass2-he-fn}
  (jit-fn float (\{{float tofp} {float length} {float time} {float chi2}}
    {do
      (= {has-tof} (>= chi2 0.0f))
      (= {p2}      (* 4.0 (* tofp tofp)))
      (= {safe-l}  (if (> length 0.0f) {length} {1.0f}))
      (= {btinv}   (/ (* time tof-c) safe-l))
      ;;; Require physical 1/β: btinv ∈ (0.9, 7.0) — rejects bad TOF associations
      ;;; (spurious hits have time >> L/c or time ≤ 0, giving btinv outside this range)
      (= {m2} (* p2 (- (* btinv btinv) 1.0f)))
      (if (< chi2 0.0f)
        {(- 0.0f 999.0f)}
        {(if (< btinv 0.9f)
          {(- 0.0f 999.0f)}
          {(if (> btinv 7.0f) {(- 0.0f 999.0f)} {m2})})})})))

(def {mass2-he-ptr} (jitfn-ptr mass2-he-fn))

;;; ── Combined nuclei PID masks ────────────────────────────────────────────
;;; (pid-nuclei-masks sig-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c)
;;;   → list {he3-mask he4-mask}
;;;
;;; sig-c      — fTPCSignal
;;; pinner-c   — momentum at inner TPC wall (= rigidity for Z=2)
;;; tofchi2-c  — fTOFChi2 (< 0 = no TOF hit; passes TOF by default)
;;; tofp-c     — fTOFExpMom (rigidity at TOF surface)
;;; length-c   — fLength (track length in cm)
;;; time-c     — fTrackTime (measured TOF arrival time in ns)
;;; timeres-c  — fTrackTimeRes (TOF time resolution in ns)
;;;
;;; Note: anti-particle selection (fSigned1Pt < 0) is NOT applied here —
;;; apply it separately as a column mask before calling this function.
(def {pid-nuclei-masks}
  (\ {sig-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c}
    {do
      (= {tpc-he3} (col-zip-ptr pid-he3-ptr sig-c pinner-c))
      (= {tpc-he4} (col-zip-ptr pid-he4-ptr sig-c pinner-c))

      (= {texp-he3} (col-zip-ptr tof-texp-he3-ptr tofp-c length-c))
      (= {texp-he4} (col-zip-ptr tof-texp-he4-ptr tofp-c length-c))

      (= {tof-he3} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-he3 timeres-c))
      (= {tof-he4} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-he4 timeres-c))

      (list
        (col-and tpc-he3 tof-he3)
        (col-and tpc-he4 tof-he4))}))

(provide {pid-nuclei-masks
          pid-m-he3 pid-m-he4
          bb-he3-fn bb-he3-ptr
          nsig-tpc-he3-fn nsig-tpc-he4-fn
          nsig-tpc-he3-ptr nsig-tpc-he4-ptr
          pid-he3-fn pid-he4-fn
          pid-he3-ptr pid-he4-ptr
          tof-texp-he3-fn tof-texp-he4-fn
          tof-texp-he3-ptr tof-texp-he4-ptr
          mass2-he-fn mass2-he-ptr})
