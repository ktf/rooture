;;; examples/pid_tpc.rut
;;;
;;; TPC PID via ALEPH Bethe-Bloch parameterization.
;;; Computes per-track species masks from fTPCSignal and total momentum.
;;;
;;; Supported species: El  Mu  Pi  Ka  Pr  De
;;; Index in pid-masks list:  0   1   2   3   4   5
;;;
;;; Parameters (override before loading):
;;;   bb0..bb4   — ALEPH BB shape params (defaults scaled for Run2 a.u., MIP~50)
;;;   bb-res     — relative resolution  (default 0.07 = 7%)
;;;   nsigma-max — |nσ| cut            (default 2.0)
;;;   p-min-pid  — minimum total momentum for PID (default 0.1 GeV/c)
;;;                Below this threshold TPC track reconstruction is unreliable
;;;                and the signal is junk (per tracking expert advice).
;;;
;;; Usage:
;;;   (load "examples/pid_tpc.rut")
;;;   ; per time-frame:
;;;   (= {pmasks} (pid-masks sig-c p-c))
;;;   (col-fill-h1 h-pi (col-mask (col-zip-ptr mul-ptr (nth 2 pmasks) mask) pt-c))

;;; ── BB parameters ────────────────────────────────────────────────────────
;;; O2Physics ALEPH defaults scaled so MIP(pion) ~ 50 Run2 a.u.
(default {bb0}        1.60491)
(default {bb1}        19.9768)
(default {bb2}        2.52666e-16)
(default {bb3}        2.72123)
(default {bb4}        6.08092)
(default {bb-res}     0.07)
(default {nsigma-max} 3.0)
(default {p-min-pid}  0.1)   ;;; 100 MeV/c — below this TPC PID is unreliable
(default {sig-min}    20.0)  ;;; min TPC signal — tracks with near-zero signal have failed extraction

;;; ── Particle masses (GeV/c^2) as globals ─────────────────────────────────
;;; Declared as globals so jit-fn constant-folding picks them up.
(def {pid-m-el} 0.000511)
(def {pid-m-mu} 0.105658)
(def {pid-m-pi} 0.139570)
(def {pid-m-ka} 0.493677)
(def {pid-m-pr} 0.938272)
(def {pid-m-de} 1.875613)

;;; Speed of light in cm/ns — for TOF expected-time calculation.
;;; t_exp [ns] = fLength [cm] / (beta_exp * tof-c)  (fTrackTime/fTrackTimeRes are in ns)
(def {tof-c} 29.9792458)

;;; ── BB nσ jit-fn template ────────────────────────────────────────────────
;;; Each species gets its own jit-fn with its mass constant-folded.
;;; Structure: all assignments at the top do-level; if branches are
;;; single expressions (no do-blocks), satisfying the C++ ternary constraint.

(def {pid-el-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-el))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-mu-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-mu))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-pi-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-pi))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-ka-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-ka))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-pr-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-pr))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

(def {pid-de-fn}
  (jit-fn float (\{{float sig} {float pinner}}
    {do
      (= {bg}     (/ pinner pid-m-de))
      (= {safe}   (> bg 0.05))
      (= {bg_s}   (if safe {bg}   {1.0}))
      (= {beta}   (/ bg_s (sqrt (+ 1.0 (* bg_s bg_s)))))
      (= {aa}     (pow beta bb3))
      (= {lnt}    (log (+ bb2 (pow (/ 1.0 bg_s) bb4))))
      (= {exp_}   (if safe {(/ (* (- (- bb1 aa) lnt) bb0) aa)} {9999.0}))
      (= {sigma}  (* bb-res exp_))
      (= {nsig}   (if (> exp_ 1.0) {(/ (- sig exp_) sigma)} {9999.0}))
      (if (< (fabs nsig) nsigma-max) {1.0f} {0.0f})})))

;;; ── Function pointers ────────────────────────────────────────────────────
(def {pid-el-ptr} (jitfn-ptr pid-el-fn))
(def {pid-mu-ptr} (jitfn-ptr pid-mu-fn))
(def {pid-pi-ptr} (jitfn-ptr pid-pi-fn))
(def {pid-ka-ptr} (jitfn-ptr pid-ka-fn))
(def {pid-pr-ptr} (jitfn-ptr pid-pr-fn))
(def {pid-de-ptr} (jitfn-ptr pid-de-fn))

;;; ── Validity cuts ────────────────────────────────────────────────────────
;;; Tracks with p < p-min-pid have unreliable TPC reconstruction (junk signal).
;;; Tracks with sig < sig-min have failed TPC signal extraction (near-zero).
(def {pid-p-ok-fn}   (jit-fn float (\{{float p}}   {(if (> p p-min-pid) {1.0f} {0.0f})})))
(def {pid-p-ok-ptr}  (jitfn-ptr pid-p-ok-fn))
(def {pid-sig-ok-fn} (jit-fn float (\{{float sig}} {(if (> sig sig-min) {1.0f} {0.0f})})))
(def {pid-sig-ok-ptr}(jitfn-ptr pid-sig-ok-fn))

;;; ── TOF PID ──────────────────────────────────────────────────────────────
;;; Extends TPC PID with TOF beta measurement for tracks that have a TOF hit.
;;; For tracks without a TOF hit (fTOFChi2 < 0), the TOF requirement passes by default,
;;; so the combined mask reduces to TPC-only for those tracks.
;;;
;;; Per-species expected TOF time: (fTOFExpMom [GeV/c], fLength [cm]) → t_exp [ns]
;;; beta_exp = p / sqrt(p² + m²);  t_exp = fLength / (beta_exp * tof-c)

(def {tof-texp-el-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-el))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

(def {tof-texp-mu-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-mu))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

(def {tof-texp-pi-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-pi))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

(def {tof-texp-ka-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-ka))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

(def {tof-texp-pr-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-pr))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

(def {tof-texp-de-fn}
  (jit-fn float (\{{float p} {float length}}
    {do (= {bg}   (/ p pid-m-de))
        (= {beta} (/ bg (sqrtf (+ 1.0f (* bg bg)))))
        (/ length (* beta tof-c))})))

;;; TOF accept mask (species-independent):
;;; (fTOFChi2, fTrackTime, t_exp, fTrackTimeRes) → 1.0 if accepted, 0.0 if rejected
;;; Accepts if: no TOF hit (chi2 < 0) OR bad resolution (t_res <= 0) OR |nσ_TOF| < nsigma-max
(def {tof-ok-fn}
  (jit-fn float (\{{float chi2} {float t_meas} {float t_exp} {float t_res}}
    {(if (< chi2 0.0f)
      {1.0f}
      {(if (<= t_res 0.0f)
        {1.0f}
        {(if (< (fabsf (/ (- t_meas t_exp) t_res)) nsigma-max)
          {1.0f}
          {0.0f})})})})))

(def {tof-texp-el-ptr} (jitfn-ptr tof-texp-el-fn))
(def {tof-texp-mu-ptr} (jitfn-ptr tof-texp-mu-fn))
(def {tof-texp-pi-ptr} (jitfn-ptr tof-texp-pi-fn))
(def {tof-texp-ka-ptr} (jitfn-ptr tof-texp-ka-fn))
(def {tof-texp-pr-ptr} (jitfn-ptr tof-texp-pr-fn))
(def {tof-texp-de-ptr} (jitfn-ptr tof-texp-de-fn))
(def {tof-ok-ptr}      (jitfn-ptr tof-ok-fn))

;;; ── pid-masks ─────────────────────────────────────────────────────────────
;;; (pid-masks sig-c p-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c)
;;;   → list of 6 float32 masks: {el mu pi ka pr de}
;;; p-c      — total reconstructed momentum (p > p-min-pid validity cut)
;;; pinner-c — momentum at inner TPC wall (BB evaluation)
;;; tofchi2-c — fTOFChi2 (< 0 = no hit; passes TOF requirement by default)
;;; tofp-c   — fTOFExpMom (momentum at TOF, used for t_exp)
;;; length-c  — fLength (track length in cm)
;;; time-c   — fTrackTime (measured TOF time in ns)
;;; timeres-c — fTrackTimeRes (TOF time resolution in ns)
(def {pid-masks} (\{sig-c p-c pinner-c tofchi2-c tofp-c length-c time-c timeres-c}
  {do
  (= {m-p}   (col-map-ptr pid-p-ok-ptr   p-c))
  (= {m-sig} (col-map-ptr pid-sig-ok-ptr sig-c))
  (= {m-ok}  (col-and m-p m-sig))

  ;;; TPC nσ masks
  (= {tpc-el} (col-zip-ptr pid-el-ptr sig-c pinner-c))
  (= {tpc-mu} (col-zip-ptr pid-mu-ptr sig-c pinner-c))
  (= {tpc-pi} (col-zip-ptr pid-pi-ptr sig-c pinner-c))
  (= {tpc-ka} (col-zip-ptr pid-ka-ptr sig-c pinner-c))
  (= {tpc-pr} (col-zip-ptr pid-pr-ptr sig-c pinner-c))
  (= {tpc-de} (col-zip-ptr pid-de-ptr sig-c pinner-c))

  ;;; TOF expected times per species
  (= {texp-el} (col-zip-ptr tof-texp-el-ptr tofp-c length-c))
  (= {texp-mu} (col-zip-ptr tof-texp-mu-ptr tofp-c length-c))
  (= {texp-pi} (col-zip-ptr tof-texp-pi-ptr tofp-c length-c))
  (= {texp-ka} (col-zip-ptr tof-texp-ka-ptr tofp-c length-c))
  (= {texp-pr} (col-zip-ptr tof-texp-pr-ptr tofp-c length-c))
  (= {texp-de} (col-zip-ptr tof-texp-de-ptr tofp-c length-c))

  ;;; TOF accept masks: 1.0 if no hit OR |nσ_TOF| < nsigma-max
  (= {tof-el} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-el timeres-c))
  (= {tof-mu} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-mu timeres-c))
  (= {tof-pi} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-pi timeres-c))
  (= {tof-ka} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-ka timeres-c))
  (= {tof-pr} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-pr timeres-c))
  (= {tof-de} (col-zip-ptr tof-ok-ptr tofchi2-c time-c texp-de timeres-c))

  ;;; Combined: validity × TPC × TOF
  (list
    (col-and m-ok tpc-el tof-el)
    (col-and m-ok tpc-mu tof-mu)
    (col-and m-ok tpc-pi tof-pi)
    (col-and m-ok tpc-ka tof-ka)
    (col-and m-ok tpc-pr tof-pr)
    (col-and m-ok tpc-de tof-de))}))


(print "pid_tpc.rut loaded."
  "bb0=" bb0 "bb-res=" bb-res "nsigma-max=" nsigma-max
  "p-min-pid=" p-min-pid "sig-min=" sig-min)
