;;; v0_invariant_mass.rut
;;;
;;; Plot K0s → π+π- and Λ/Λ̄ → pπ∓ invariant mass spectra from O2v0_002
;;; using proper topological V0 selection.
;;;
;;; Topological cuts (applied via col-dca-v0 + col-cpa):
;;;   dca_daughters < 1.0 cm   — daughters must actually cross
;;;   v0_radius     > 5.0 cm   — decay vertex displaced from beam
;;;   cos(PA)       > 0.995    — V0 momentum points back to primary vertex
;;;
;;; Run:
;;;   (load "examples/v0_invariant_mass.rut")

(load stdlib.rut)

(def {aod-path} "/Users/ktf/src/O2/AO2D.root")
(def {trk-tree} "O2track_iu")
(def {v0-tree}  "O2v0_002")
(def {col-tree} "O2collision_001")

;;; Solenoid field [T]. ALICE Run 3 nominal: +0.5 or -0.5 depending on fill.
(def {bz} 0.5)

;;; ── Collect timeframe names ───────────────────────────────────────────────
(def {tf-keys}  (.GetListOfKeys (new TFile aod-path "READ")))
(def {tf-names} (do
  (= {acc} {})
  (dotimes {i} (.GetEntries tf-keys) {
    do
    (= {k} (.At tf-keys i))
    (if (== (.GetClassName k) "TDirectoryFile")
      {= {acc} (join acc (list (.GetName k)))}
      {})
  })
  acc))
(print "Timeframes:" (len tf-names))

;;; ── JIT functions ─────────────────────────────────────────────────────────
;;; Daughter momentum components
(def {px-fn} (jit-fn float (\{{float s1pt} {float alpha} {float snp}}
  {(* (if (== s1pt 0.) {0.} {(/ 1. (::Abs TMath s1pt))})
     (::Cos TMath (+ alpha (::ASin TMath snp))))})))
(def {py-fn} (jit-fn float (\{{float s1pt} {float alpha} {float snp}}
  {(* (if (== s1pt 0.) {0.} {(/ 1. (::Abs TMath s1pt))})
     (::Sin TMath (+ alpha (::ASin TMath snp))))})))
(def {pz-fn} (jit-fn float (\{{float s1pt} {float tgl}}
  {(* (if (== s1pt 0.) {0.} {(/ 1. (::Abs TMath s1pt))}) tgl)})))

;;; V0 momentum = sum of daughters
(def {add-fn} (jit-fn float (\{{float a} {float b}} {(+ a b)})))

;;; V0 geometry: helix propagation in uniform Bz.
;;; Replaces col-dca-v0 builtin with a single fused col-jit-fn kernel (O2).
;;; Inputs: 14 float32 track-parameter columns + scalar bz (constant-folded).
;;; Outputs: {vtx-x vtx-y vtx-z dca-daughters}
(def {dca-v0-jit-fn}
  (col-jit-fn {float float float float}
    (\{{col sp} {col ap} {col np} {col tp} {col xp} {col yp} {col zp}
       {col sn} {col an} {col nn} {col tn} {col xn} {col yn} {col zn}}
      {do
        ;;; curvature [1/cm]; clamp near-zero to avoid division singularity
        (= {crp0} (* sp bz 0.003))
        (= {crp}  (if (< (::Abs TMath crp0) 1e-9) {(if (>= crp0 0.) {1e-9} {-1e-9})} {crp0}))
        (= {crn0} (* sn bz 0.003))
        (= {crn}  (if (< (::Abs TMath crn0) 1e-9) {(if (>= crn0 0.) {1e-9} {-1e-9})} {crn0}))
        (= {Rp}   (/ 1. (::Abs TMath crp)))
        (= {Rn}   (/ 1. (::Abs TMath crn)))
        ;;; local → global XY
        (= {cap} (::Cos TMath ap))  (= {sap} (::Sin TMath ap))
        (= {can} (::Cos TMath an))  (= {san} (::Sin TMath an))
        (= {xgp} (- (* xp cap) (* yp sap)))  (= {ygp} (+ (* xp sap) (* yp cap)))
        (= {xgn} (- (* xn can) (* yn san)))  (= {ygn} (+ (* xn san) (* yn can)))
        ;;; global track direction (cos/sin of azimuthal angle φ = alpha + asin(snp))
        (= {snp2p} (* np np))
        (= {c1p}  (::Sqrt TMath (if (> (- 1. snp2p) 0.) {(- 1. snp2p)} {0.})))
        (= {snp2n} (* nn nn))
        (= {c1n}  (::Sqrt TMath (if (> (- 1. snp2n) 0.) {(- 1. snp2n)} {0.})))
        (= {cphp} (- (* cap c1p) (* sap np)))  (= {sphp} (+ (* sap c1p) (* cap np)))
        (= {cphn} (- (* can c1n) (* san nn)))  (= {sphn} (+ (* san c1n) (* can nn)))
        ;;; helix centers: cx = xg + sinφ/crv,  cy = yg - cosφ/crv
        (= {cxp} (+ xgp (/ sphp crp)))  (= {cyp} (- ygp (/ cphp crp)))
        (= {cxn} (+ xgn (/ sphn crn)))  (= {cyn} (- ygn (/ cphn crn)))
        ;;; circle-circle separation
        (= {dcx} (- cxn cxp))  (= {dcy} (- cyn cyp))
        (= {d}   (::Sqrt TMath (+ (* dcx dcx) (* dcy dcy))))
        ;;; precompute all vertex candidates, select with ternaries
        (= {invd} (if (> d 1e-6) {(/ 1. d)} {0.}))
        (= {t}    (* 0.5 (+ d (* (- (* Rp Rp) (* Rn Rn)) invd))))
        (= {h2}   (- (* Rp Rp) (* t t)))
        (= {mx}   (+ cxp (* t dcx invd)))
        (= {my}   (+ cyp (* t dcy invd)))
        (= {h}    (::Sqrt TMath (if (> h2 0.) {h2} {0.})))
        (= {px1}  (+ mx (* (* -1. dcy) (* h invd))))
        (= {py1}  (+ my (* dcx (* h invd))))
        (= {px2}  (- mx (* (* -1. dcy) (* h invd))))
        (= {py2}  (- my (* dcx (* h invd))))
        (= {dot1} (+ (* (- px1 xgp) cphp) (* (- py1 ygp) sphp)))
        (= {dot2} (+ (* (- px2 xgp) cphp) (* (- py2 ygp) sphp)))
        (= {vx_i} (if (>= dot1 dot2) {px1} {px2}))
        (= {vy_i} (if (>= dot1 dot2) {py1} {py2}))
        (= {vx_ni} (* 0.5 (+ (+ cxp (* Rp dcx invd)) (- cxn (* Rn dcx invd)))))
        (= {vy_ni} (* 0.5 (+ (+ cyp (* Rp dcy invd)) (- cyn (* Rn dcy invd)))))
        (= {vx} (if (< d 1e-6) {(* 0.5 (+ xgp xgn))} {(if (<= h2 0.) {vx_ni} {vx_i})}))
        (= {vy} (if (< d 1e-6) {(* 0.5 (+ ygp ygn))} {(if (<= h2 0.) {vy_ni} {vy_i})}))
        ;;; z via arc-length propagation — while loops replaced by single corrections
        ;;; (valid: V0 arc always < one full revolution for ALICE V0s)
        (= {dthp0} (- (::ATan2 TMath (- vy cyp) (- vx cxp))
                      (::ATan2 TMath (- ygp cyp) (- xgp cxp))))
        (= {dthp1} (if (< crp 0.)
          {(if (< dthp0 0.) {(+ dthp0 6.2831853)} {dthp0})}
          {(if (> dthp0 0.) {(- dthp0 6.2831853)} {dthp0})}))
        (= {dthp}  (if (< crp 0.)
          {(if (> dthp1 3.14159265) {(- dthp1 6.2831853)} {dthp1})}
          {(if (< dthp1 -3.14159265) {(+ dthp1 6.2831853)} {dthp1})}))
        (= {vzp}   (+ zp (* Rp (::Abs TMath dthp) tp)))
        (= {dthn0} (- (::ATan2 TMath (- vy cyn) (- vx cxn))
                      (::ATan2 TMath (- ygn cyn) (- xgn cxn))))
        (= {dthn1} (if (< crn 0.)
          {(if (< dthn0 0.) {(+ dthn0 6.2831853)} {dthn0})}
          {(if (> dthn0 0.) {(- dthn0 6.2831853)} {dthn0})}))
        (= {dthn}  (if (< crn 0.)
          {(if (> dthn1 3.14159265) {(- dthn1 6.2831853)} {dthn1})}
          {(if (< dthn1 -3.14159265) {(+ dthn1 6.2831853)} {dthn1})}))
        (= {vzn}   (+ zn (* Rn (::Abs TMath dthn) tn)))
        (= {vz}    (* 0.5 (+ vzp vzn)))
        ;;; 3D DCA: nearest points on each helix to the vertex
        (= {dxp}  (- vx cxp))  (= {dyp}  (- vy cyp))
        (= {ddp}  (::Sqrt TMath (+ (* dxp dxp) (* dyp dyp))))
        (= {cpxp} (if (< ddp 1e-8) {(+ cxp Rp)} {(+ cxp (* Rp (/ dxp ddp)))}))
        (= {cpyp} (if (< ddp 1e-8) {cyp}         {(+ cyp (* Rp (/ dyp ddp)))}))
        (= {dxn}  (- vx cxn))  (= {dyn}  (- vy cyn))
        (= {ddn}  (::Sqrt TMath (+ (* dxn dxn) (* dyn dyn))))
        (= {cpxn} (if (< ddn 1e-8) {(+ cxn Rn)} {(+ cxn (* Rn (/ dxn ddn)))}))
        (= {cpyn} (if (< ddn 1e-8) {cyn}         {(+ cyn (* Rn (/ dyn ddn)))}))
        (= {dxy2} (+ (* (- cpxp cpxn) (- cpxp cpxn)) (* (- cpyp cpyn) (- cpyp cpyn))))
        (= {dca}  (::Sqrt TMath (+ dxy2 (* (- vzp vzn) (- vzp vzn)))))
        {vx vy vz dca}})))

;;; Cosine of opening angle between daughters — single fused pass
(def {cos-oa-fn}
  (col-jit-fn float
    (\{{col ppx} {col ppy} {col ppz}
       {col npx} {col npy} {col npz}}
      {do
        (= {p2p} (+ (* ppx ppx) (+ (* ppy ppy) (* ppz ppz))))
        (= {p2n} (+ (* npx npx) (+ (* npy npy) (* npz npz))))
        (= {den} (::Sqrt TMath (* p2p p2n)))
        (if (== den 0.) {0.} {(/ (+ (* ppx npx) (+ (* ppy npy) (* ppz npz))) den)})})))

;;; V0 transverse radius = sqrt(x² + y²)
(def {radius-fn} (jit-fn float (\{{float x} {float y}}
  {(::Sqrt TMath (+ (* x x) (* y y)))})))

;;; Topological cut functions (return 1.0 if cut passes, 0.0 otherwise)
(def {dca-cut-fn}    (jit-fn float (\{{float dca}} {(if (< dca 1.0)  {1.} {0.})})))
(def {radius-cut-fn} (jit-fn float (\{{float r}}   {(if (> r 5.0)   {1.} {0.})})))
(def {cpa-cut-fn}    (jit-fn float (\{{float c}}   {(if (> c 0.995) {1.} {0.})})))

;;; V0 type bit checks (only values 1 and 7 observed in this dataset)
(def {k0s-type-fn} (jit-fn float (\{{float v}}
  {(if (== v 1.) {1.} {(if (== v 7.) {1.} {0.})})})))
(def {lam-type-fn} (jit-fn float (\{{float v}}
  {(if (== v 7.) {1.} {0.})})))

;;; Armenteros-Podolanski (α, q_T) — single-pass fused kernel via col-jit-fn.
;;; Inputs: 9 float32 momentum columns (pos px/py/pz, neg px/py/pz, V0 px/py/pz).
(def {arm-jit-fn}
  (col-jit-fn {float float}
    (\{{col ppx} {col ppy} {col ppz}
       {col npx} {col npy} {col npz}
       {col vpx} {col vpy} {col vpz}}
      {do
        (= {vp}  (::Sqrt TMath (+ (* vpx vpx) (+ (* vpy vpy) (* vpz vpz)))))
        (= {pLp} (if (== vp 0.) {0.} {(/ (+ (* ppx vpx) (+ (* ppy vpy) (* ppz vpz))) vp)}))
        (= {pLn} (if (== vp 0.) {0.} {(/ (+ (* npx vpx) (+ (* npy vpy) (* npz vpz))) vp)}))
        (= {den} (+ pLp pLn))
        (= {p2}  (+ (* ppx ppx) (+ (* ppy ppy) (* ppz ppz))))
        (= {qt2} (- p2 (* pLp pLp)))
        {(if (< (::Abs TMath den) 0.00000001) {0.} {(/ (- pLp pLn) den)})
         (::Sqrt TMath (if (> qt2 0.) {qt2} {0.}))}})))

;;; Armenteros-Podolanski selection
;;; Λ:  α > 0.4 (proton carries most momentum), q_T < 0.12 GeV/c
;;; Λ̄:  α < -0.4 (anti-proton carries most momentum), q_T < 0.12 GeV/c
;;; K0s: q_T > 0.07 GeV/c AND |α| < 0.7 (symmetric ellipse; removes Λ/Λ̄ arms)
(def {lam-arm-fn}  (jit-fn float (\{{float a} {float q}}
  {(if (> a 0.4) {(if (< q 0.12) {1.} {0.})} {0.})})))
(def {alam-arm-fn} (jit-fn float (\{{float a} {float q}}
  {(if (< a -0.4) {(if (< q 0.12) {1.} {0.})} {0.})})))
(def {k0s-arm-fn}  (jit-fn float (\{{float a} {float q}}
  {(if (> q 0.07) {(if (< (::Abs TMath a) 0.7) {1.} {0.})} {0.})})))

(def {cos-oa-cut-fn} (jit-fn float (\{{float c}} {(if (< c 0.99) {1.} {0.})})))
(def {mul-fn} (jit-fn float (\{{float a} {float b}} {(* a b)})))

(def {px-ptr}          (jitfn-ptr px-fn))
(def {py-ptr}          (jitfn-ptr py-fn))
(def {pz-ptr}          (jitfn-ptr pz-fn))
(def {add-ptr}         (jitfn-ptr add-fn))
(def {radius-ptr}      (jitfn-ptr radius-fn))
(def {dca-cut-ptr}     (jitfn-ptr dca-cut-fn))
(def {radius-cut-ptr}  (jitfn-ptr radius-cut-fn))
(def {cpa-cut-ptr}     (jitfn-ptr cpa-cut-fn))
(def {k0s-type-ptr}    (jitfn-ptr k0s-type-fn))
(def {lam-type-ptr}    (jitfn-ptr lam-type-fn))
(def {lam-arm-ptr}     (jitfn-ptr lam-arm-fn))
(def {alam-arm-ptr}    (jitfn-ptr alam-arm-fn))
(def {k0s-arm-ptr}     (jitfn-ptr k0s-arm-fn))
(def {cos-oa-cut-ptr}  (jitfn-ptr cos-oa-cut-fn))
(def {mul-ptr}         (jitfn-ptr mul-fn))

;;; ── Mass hypotheses (GeV/c²) ─────────────────────────────────────────────
(def {m-pi} 0.13957)
(def {m-pr} 0.93827)

;;; ── Pre-create per-TF histograms ─────────────────────────────────────────
(def {tf-hk0s} (map (\ {tf} {doto (new TH1F (concat "k0s_" tf) "" 200 0.43 0.565) {SetDirectory 0}}) tf-names))
(def {tf-hlam} (map (\ {tf} {doto (new TH1F (concat "lam_" tf) "" 160 1.08 1.16)  {SetDirectory 0}}) tf-names))
(def {tf-harm} (map (\ {tf} {doto (new TH2F (concat "arm_" tf) "" 100 -1. 1. 100 0. 0.25) {SetDirectory 0}}) tf-names))

(def {tf-idx} (do
  (= {acc} {})
  (dotimes {i} (len tf-names) {= {acc} (join acc (list i))})
  acc))

;;; ── Parallel fill ────────────────────────────────────────────────────────
(def {sw} (doto (new TStopwatch) {Start}))

(pmap (\ {i} {
  do
  (= {tf}   (nth i tf-names))
  (= {hk0s} (nth i tf-hk0s))
  (= {hlam} (nth i tf-hlam))
  (= {harm} (nth i tf-harm))

  ;;; V0 table branches
  (= {pos-idx}   (load-branch aod-path (concat tf "/" v0-tree)  "fIndexTracks_Pos"))
  (= {neg-idx}   (load-branch aod-path (concat tf "/" v0-tree)  "fIndexTracks_Neg"))
  (= {v0-colidx} (load-branch aod-path (concat tf "/" v0-tree)  "fIndexCollisions"))
  (= {vtype-c}   (load-branch aod-path (concat tf "/" v0-tree)  "fV0Type"))

  ;;; Track parameter branches (7 per track)
  (= {s1pt-c}  (load-branch aod-path (concat tf "/" trk-tree) "fSigned1Pt"))
  (= {alpha-c} (load-branch aod-path (concat tf "/" trk-tree) "fAlpha"))
  (= {snp-c}   (load-branch aod-path (concat tf "/" trk-tree) "fSnp"))
  (= {tgl-c}   (load-branch aod-path (concat tf "/" trk-tree) "fTgl"))
  (= {x-c}     (load-branch aod-path (concat tf "/" trk-tree) "fX"))
  (= {y-c}     (load-branch aod-path (concat tf "/" trk-tree) "fY"))
  (= {z-c}     (load-branch aod-path (concat tf "/" trk-tree) "fZ"))

  ;;; Primary vertex positions (per collision)
  (= {pv-x-c}  (load-branch aod-path (concat tf "/" col-tree) "fPosX"))
  (= {pv-y-c}  (load-branch aod-path (concat tf "/" col-tree) "fPosY"))
  (= {pv-z-c}  (load-branch aod-path (concat tf "/" col-tree) "fPosZ"))

  ;;; Gather track params for each daughter
  (= {pos-s1pt}  (col-gather s1pt-c  pos-idx))
  (= {pos-alpha} (col-gather alpha-c pos-idx))
  (= {pos-snp}   (col-gather snp-c   pos-idx))
  (= {pos-tgl}   (col-gather tgl-c   pos-idx))
  (= {pos-x}     (col-gather x-c     pos-idx))
  (= {pos-y}     (col-gather y-c     pos-idx))
  (= {pos-z}     (col-gather z-c     pos-idx))
  (= {neg-s1pt}  (col-gather s1pt-c  neg-idx))
  (= {neg-alpha} (col-gather alpha-c neg-idx))
  (= {neg-snp}   (col-gather snp-c   neg-idx))
  (= {neg-tgl}   (col-gather tgl-c   neg-idx))
  (= {neg-x}     (col-gather x-c     neg-idx))
  (= {neg-y}     (col-gather y-c     neg-idx))
  (= {neg-z}     (col-gather z-c     neg-idx))

  ;;; Gather PV position for each V0 via its collision index
  (= {pv-x} (col-gather pv-x-c v0-colidx))
  (= {pv-y} (col-gather pv-y-c v0-colidx))
  (= {pv-z} (col-gather pv-z-c v0-colidx))

  ;;; Compute V0 geometry: decay vertex + DCA between daughters (fused col-jit-fn)
  (= {v0geo}   (dca-v0-jit-fn
    pos-s1pt pos-alpha pos-snp pos-tgl pos-x pos-y pos-z
    neg-s1pt neg-alpha neg-snp neg-tgl neg-x neg-y neg-z))
  (= {vtx-x}   (nth 0 v0geo))
  (= {vtx-y}   (nth 1 v0geo))
  (= {vtx-z}   (nth 2 v0geo))
  (= {dca-dau} (nth 3 v0geo))

  ;;; Daughter momenta and V0 momentum sum
  (= {pos-px} (col-zip-ptr px-ptr pos-s1pt pos-alpha pos-snp))
  (= {pos-py} (col-zip-ptr py-ptr pos-s1pt pos-alpha pos-snp))
  (= {pos-pz} (col-zip-ptr pz-ptr pos-s1pt pos-tgl))
  (= {neg-px} (col-zip-ptr px-ptr neg-s1pt neg-alpha neg-snp))
  (= {neg-py} (col-zip-ptr py-ptr neg-s1pt neg-alpha neg-snp))
  (= {neg-pz} (col-zip-ptr pz-ptr neg-s1pt neg-tgl))
  (= {v0-px}  (col-zip-ptr add-ptr pos-px neg-px))
  (= {v0-py}  (col-zip-ptr add-ptr pos-py neg-py))
  (= {v0-pz}  (col-zip-ptr add-ptr pos-pz neg-pz))

  ;;; Cosine of pointing angle and transverse decay radius
  (= {cpa}    (col-cpa vtx-x vtx-y vtx-z pv-x pv-y pv-z v0-px v0-py v0-pz))
  (= {radius} (col-zip-ptr radius-ptr vtx-x vtx-y))

    ;;; Topological selection mask
  (= {topo-mask}
    (col-zip-ptr mul-ptr
      (col-zip-ptr mul-ptr
        (col-map-ptr dca-cut-ptr    dca-dau)
        (col-map-ptr radius-cut-ptr radius))
      (col-map-ptr cpa-cut-ptr cpa)))

  ;;; Armenteros-Podolanski variables (fused col-jit-fn kernel, O2)
  (= {arm}       (arm-jit-fn pos-px pos-py pos-pz neg-px neg-py neg-pz v0-px v0-py v0-pz))
  (= {arm-alpha} (nth 0 arm))
  (= {arm-qt}    (nth 1 arm))

  ;;; Combined masks: topology × type × Armenteros
  (= {vtype-f}   (col-cast-f32 vtype-c))
  (= {k0s-base}  (col-zip-ptr mul-ptr topo-mask (col-map-ptr k0s-type-ptr vtype-f)))
  (= {lam-base}  (col-zip-ptr mul-ptr topo-mask (col-map-ptr lam-type-ptr vtype-f)))
  (= {k0s-mask}  (col-zip-ptr mul-ptr k0s-base  (col-zip-ptr k0s-arm-ptr  arm-alpha arm-qt)))
  (= {lam-mask}  (col-zip-ptr mul-ptr lam-base  (col-zip-ptr lam-arm-ptr  arm-alpha arm-qt)))
  (= {alam-mask} (col-zip-ptr mul-ptr lam-base  (col-zip-ptr alam-arm-ptr arm-alpha arm-qt)))

  ;;; Armenteros scatter plot (topo-masked candidates only)
  (col-fill-h2 harm (col-mask topo-mask arm-alpha) (col-mask topo-mask arm-qt))

  ;;; K0s → π+π-  (Armenteros: q_T > 0.07 GeV/c, |α| < 0.7)
  (col-fill-minv2-h1 hk0s
    (col-mask k0s-mask pos-px) (col-mask k0s-mask pos-py) (col-mask k0s-mask pos-pz)
    (col-mask k0s-mask neg-px) (col-mask k0s-mask neg-py) (col-mask k0s-mask neg-pz)
    m-pi m-pi)

  ;;; Λ → pπ-  (pos = proton, Armenteros: α > 0, q_T < 0.12 GeV/c)
  (col-fill-minv2-h1 hlam
    (col-mask lam-mask pos-px) (col-mask lam-mask pos-py) (col-mask lam-mask pos-pz)
    (col-mask lam-mask neg-px) (col-mask lam-mask neg-py) (col-mask lam-mask neg-pz)
    m-pr m-pi)

  ;;; Λ̄ → p̄π+  (neg = anti-proton, Armenteros: α < 0, q_T < 0.12 GeV/c)
  (col-fill-minv2-h1 hlam
    (col-mask alam-mask pos-px) (col-mask alam-mask pos-py) (col-mask alam-mask pos-pz)
    (col-mask alam-mask neg-px) (col-mask alam-mask neg-py) (col-mask alam-mask neg-pz)
    m-pi m-pr)
}) tf-idx)

(.Stop sw)
(print "Wall time:" (.RealTime sw) "s")

;;; ── Merge ────────────────────────────────────────────────────────────────
(def {h-k0s}
  (doto (new TH1F "hk0s"
             "K^{0}_{S} #rightarrow #pi^{+}#pi^{-};m_{#pi#pi} (GeV/c^{2});V0 candidates"
             200 0.43 0.565)
    {SetDirectory 0} {SetLineWidth 2}))
(def {h-lam}
  (doto (new TH1F "hlam"
             "#Lambda/#bar{#Lambda} #rightarrow p#pi;m_{p#pi} (GeV/c^{2});V0 candidates"
             160 1.08 1.16)
    {SetDirectory 0} {SetLineWidth 2}))

(map (\ {h} {.Add h-k0s h}) tf-hk0s)
(map (\ {h} {.Add h-lam h}) tf-hlam)

(def {h-arm}
  (doto (new TH2F "harm" "Armenteros-Podolanski;#alpha;q_{T} (GeV/c)" 100 -1. 1. 100 0. 0.25)
    {SetDirectory 0}))
(map (\ {h} {.Add h-arm h}) tf-harm)

(print "K0s selected:" (.GetEntries h-k0s) "  mean:" (.GetMean h-k0s) "GeV/c²")
(print "Lambda selected:" (.GetEntries h-lam) "  mean:" (.GetMean h-lam) "GeV/c²")

;;; ── Draw ─────────────────────────────────────────────────────────────────
(def {cv} (doto (new TCanvas "cv0" "V0 invariant mass spectra" 1600 500)
  {Divide 3 1}))
(.cd cv 1) (.Draw h-k0s)
(.cd cv 2) (.Draw h-lam)
(.cd cv 3) (.Draw h-arm "COLZ")
