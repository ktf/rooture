;;; tracks_3d_gui.rut
;;;
;;; 3-D track explorer for ALICE AO2D data.
;;; Single canvas, four pads (2×2):
;;;   pad1 (top-left)  — COLZ density: phi × sigma(pT)/pT
;;;   pad2 (top-right) — COLZ density: eta × log2(sigma(pT)/pT)
;;;   pad4 (bot-left)  — transverse X-Y section: cluster density in global X/Y
;;;   pad3 (bot-right) — 3D helices: actual track trajectories in global X/Y/Z
;;; A slider filters by minimum number of TPC clusters.
;;;
;;; Usage:
;;;   (load "/Users/ktf/src/rooture/examples/tracks_3d_gui.rut")

(load stdlib.rut)
(.Load gSystem "libGui")
(global "gClient")
(global "gInterpreter")
(def {sw-load} (doto (new TStopwatch) {Start}))
(def {t0} (\{msg} {do
  (.Stop sw-load)
  (print (concat msg " " (str (.RealTime sw-load)) "s"))
  (.Continue sw-load)}))

;;; ── File / chains ────────────────────────────────────────────────────────
(def {aod-path} "/Users/ktf/src/data/2024/LHC24ar/559575/apass1/2050/o2_ctf_run00559575_orbit0059692928_tf0000474395_epn011/001/AO2D.root")

(def {trk-chain}   (new TChain "O2track_iu"))
(def {extra-chain} (new TChain "O2trackextra_002"))
(def {cov-chain}   (new TChain "O2trackcov_iu"))

(def {f-keys} (.GetListOfKeys (new TFile aod-path "READ")))
(def {nkeys}  (.GetEntries f-keys))

(dotimes {i} nkeys {
  do
  (= {k} (.At f-keys i))
  (if (== (.GetClassName k) "TDirectoryFile")
    {do
      (= {dn} (.GetName k))
      (.Add trk-chain   (concat aod-path "?#" dn "/O2track_iu"))
      (.Add extra-chain (concat aod-path "?#" dn "/O2trackextra_002"))
      (.Add cov-chain   (concat aod-path "?#" dn "/O2trackcov_iu"))}
    {})
})

(.AddFriend trk-chain extra-chain)
(.AddFriend trk-chain cov-chain)
(t0 "chains")

;;; ── RDataFrame nodes reused across slider updates ────────────────────────
(def {rdf-helix} (new ROOT::RDataFrame trk-chain))
(def {rdf-pt}    (new ROOT::RDataFrame trk-chain))

;;; Mutable threshold box — a single-element TArrayI on the heap.
;;; filter-fn captures its address at compile time and reads the value at
;;; runtime, so the threshold can be updated without recompiling the filter.
(def {min-cls-box} (new TArrayI 1))
(.SetAt min-cls-box 0 0)

;;; filter-fn compiled once.  The transpiler folds min-cls-box to its C++
;;; pointer address; GetAt(0) reads the current threshold at call time.
(def {filter-fn}
  (jit-fn bool
    (\{{UChar_t fTPCNClsFindable} {Char_t fTPCNClsFindableMinusFound}}
      {(>= (- fTPCNClsFindable fTPCNClsFindableMinusFound) (.GetAt min-cls-box 0))})))

;;; ── Per-collision mean pT accumulators ───────────────────────────────────
;;; fIndexCollisions resets to 0 each timeframe; the same index from different
;;; DFs accumulates together, which is acceptable for a distribution in a
;;; single homogeneous run.
(def {n-coll-max} 20000)
(def {sum-pt-box} (new TArrayF n-coll-max))
(def {cnt-box}    (new TArrayI n-coll-max))
;;; Distribution histogram: one entry per collision = mean pT of its tracks.
(def {h-mean-pt}
  (new TH1F "hmeanpt" ";#LT p_{T} #GT (GeV/c);Collisions" 50 0. 2.))

(t0 "accumulators+filter-fn")

;;; ── JIT-compiled column and filter functions ─────────────────────────────
;;; Compiled once; passed directly to RDataFrame::Define / Filter as native
;;; C++ function pointers — zero interpreter overhead per entry.

;;; phi = fAlpha + arcsin(fSnp)
(def {phi-fn}
  (jit-fn float (\{{float fAlpha} {float fSnp}}
    {(+ fAlpha (::ASin TMath fSnp))})))

;;; sigma(pT)/pT = fSigma1Pt / |fSigned1Pt|
(def {sigpt-fn}
  (jit-fn float (\{{float fSigma1Pt} {float fSigned1Pt}}
    {(/ fSigma1Pt (::Abs TMath fSigned1Pt))})))

;;; N_TPC clusters found  (UChar_t - Char_t → int via promotion)
(def {ncls-fn}
  (jit-fn int (\{{UChar_t fTPCNClsFindable} {Char_t fTPCNClsFindableMinusFound}}
    {(- fTPCNClsFindable fTPCNClsFindableMinusFound)})))

;;; eta = arcsinh(tan(lambda))
(def {eta-fn}
  (jit-fn float (\{{float fTgl}}
    {(::ASinH TMath fTgl)})))

;;; log2(sigPt) — operates on the already-defined sigPt derived column
(def {log2sp-fn}
  (jit-fn float (\{{float sigPt}}
    {(::Log2 TMath sigPt)})))

;;; validity filter: fSigma1Pt > 0 and fSigned1Pt != 0
(def {sigpt-valid-fn}
  (jit-fn bool (\{{float fSigma1Pt} {float fSigned1Pt}}
    {(if (> fSigma1Pt 0.) {(!= fSigned1Pt 0.)} {0})})))

;;; pT = 1 / |q/pT|  (guarded against zero)
(def {pt-fn}
  (jit-fn float (\{{float fSigned1Pt}}
    {(if (== fSigned1Pt 0.) {0.} {(/ 1. (::Abs TMath fSigned1Pt))})})))

;;; global X: xg = fX*cos(alpha) - fY*sin(alpha)
(def {xg-fn}
  (jit-fn float (\{{float fX} {float fAlpha} {float fY}}
    {(- (* fX (::Cos TMath fAlpha)) (* fY (::Sin TMath fAlpha)))})))

;;; global Y: yg = fX*sin(alpha) + fY*cos(alpha)
(def {yg-fn}
  (jit-fn float (\{{float fX} {float fAlpha} {float fY}}
    {(+ (* fX (::Sin TMath fAlpha)) (* fY (::Cos TMath fAlpha)))})))

(t0 "column jit-fns (phi/sigpt/ncls/eta/log2sp/sigpt-valid/pt/xg/yg)")

;;; fill-accum-fn: per-entry — adds pT and count into the accumulator arrays.
;;; fIndexCollisions can be negative (O2 sentinel for ambiguous/no collision) — skip those.
(def {fill-accum-fn}
  (jit-fn void (\{{float fSigned1Pt} {int fIndexCollisions}}
    {(if (>= fIndexCollisions 0)
      {(if (< fIndexCollisions n-coll-max)
        {do
          (= {pt} (if (== fSigned1Pt 0.) {0.} {(/ 1. (::Abs TMath fSigned1Pt))}))
          (.SetAt sum-pt-box (+ (.GetAt sum-pt-box fIndexCollisions) pt) fIndexCollisions)
          (.SetAt cnt-box    (+ (.GetAt cnt-box    fIndexCollisions) 1)  fIndexCollisions)}
        {})}
      {})})))

;;; build-mean-fn: called once after Foreach — fills h-mean-pt from accumulators
(def {build-mean-fn}
  (jit-fn void (\{}
    {do
      (.Reset h-mean-pt)
      (dotimes {ic} n-coll-max {do
        (= {c} (.GetAt cnt-box ic))
        (if (> c 0)
          {(.Fill h-mean-pt (/ (.GetAt sum-pt-box ic) c))}
          {})})})))

(t0 "accum jit-fns (fill-accum/build-mean)")

;;; ── Fill TH3D once (sample of 500k tracks) ───────────────────────────────
;;; Axes: phi × sigma(pT)/pT × N_TPC cls
(def {h3raw}
  (-> (new ROOT::RDataFrame trk-chain)
    {.Range 500000}
    {.Define "phi"   phi-fn   {"fAlpha" "fSnp"}}
    {.Define "sigPt" sigpt-fn {"fSigma1Pt" "fSigned1Pt"}}
    {.Define "nCls"  ncls-fn  {"fTPCNClsFindable" "fTPCNClsFindableMinusFound"}}
    {.Histo3D (new ROOT::RDF::TH3DModel
                 "h3raw" ";#varphi;#sigma(p_{T})/p_{T};N_{TPC cls}"
                 40 -3.14159 3.14159  50 0. 0.5  161 -0.5 160.5)
              "phi" "sigPt" "nCls"}))

;;; ── Fill TH3D with log2(sigPt) axis (for pad2) ──────────────────────────
(def {h3log}
  (-> (new ROOT::RDataFrame trk-chain)
    {.Range 500000}
    {.Define "eta"    eta-fn    {"fTgl"}}
    {.Define "sigPt"  sigpt-fn  {"fSigma1Pt" "fSigned1Pt"}}
    {.Define "log2sp" log2sp-fn {"sigPt"}}
    {.Define "nCls"   ncls-fn   {"fTPCNClsFindable" "fTPCNClsFindableMinusFound"}}
    {.Filter sigpt-valid-fn {"fSigma1Pt" "fSigned1Pt"}}
    {.Histo3D (new ROOT::RDF::TH3DModel
                 "h3log" ";#eta;log_{2}(#sigma(p_{T})/p_{T});N_{TPC cls}"
                 40 -2. 2.  60 -6. 4.  161 -0.5 160.5)
              "eta" "log2sp" "nCls"}))


;;; ── Fill TH3D for transverse X-Y section (pad4) ─────────────────────────
;;; Global X/Y from local-to-global rotation: xg = fX*cos(α) - fY*sin(α),
;;;                                            yg = fX*sin(α) + fY*cos(α).
;;; Third axis is N_TPC cls so the slider cut applies via SetRange + Project3D.
(def {h3xy}
  (-> (new ROOT::RDataFrame trk-chain)
    {.Range 500000}
    {.Define "xg"   xg-fn   {"fX" "fAlpha" "fY"}}
    {.Define "yg"   yg-fn   {"fX" "fAlpha" "fY"}}
    {.Define "nCls" ncls-fn {"fTPCNClsFindable" "fTPCNClsFindableMinusFound"}}
    {.Histo3D (new ROOT::RDF::TH3DModel
                 "h3xy" ";X (cm);Y (cm);N_{TPC cls}"
                 65 -260. 260.  65 -260. 260.  161 -0.5 160.5)
              "xg" "yg" "nCls"}))

(t0 "h3raw+h3log+h3xy defined (lazy)")

;;; Column names for the helix Foreach — passed as a Q-expression of strings
;;; so rooture emits std::vector<std::string>{"fSnp",...} inline in Cling.
(def {helix-cols} {"fSnp" "fTgl" "fAlpha" "fX" "fY" "fZ" "fSigned1Pt"})

;;; JIT-compiled helix callable. O2 AO2D track branches are Float_t, so we
;;; declare explicit float parameters so RDF's CallableTraits resolves the
;;; type without needing .Define casts.
(def {helix-fn}
  (jit-fn void
    (\{{float snp} {float tgl} {float alpha} {float refx} {float refy} {float refz} {float s1pt}} {do
      (= {bz}   5.)
      (= {kB2C} 2.99792458e-4)
      (= {npts} 60)
      (= {tmin} -120.)
      (= {dt}   (/ (- 230. tmin) (- npts 1)))
      (= {C}    (* s1pt bz kB2C))
      (if (< (::Abs TMath C) 1e-9) {}
        {do
          (= {snp2} (if (< snp -1.) {-1.} {(if (> snp 1.) {1.} {snp})}))
          (= {phi0} (::ASin TMath snp2))
          (= {cs0}  (::Cos TMath phi0))
          (= {xc}   (- refx (/ snp2 C)))
          (= {yc}   (+ refy (/ cs0  C)))
          (= {ca}   (::Cos TMath alpha))
          (= {sa}   (::Sin TMath alpha))
          (= {pl}   (new TPolyLine3D npts))
          (dotimes {ip} npts {do
            (= {t}  (+ tmin (* ip dt)))
            (= {ph} (+ phi0 (* C t)))
            (= {xl} (+ xc (/ (::Sin TMath ph) C)))
            (= {yl} (- yc (/ (::Cos TMath ph) C)))
            (.SetPoint pl ip
              (- (* xl ca) (* yl sa))
              (+ (* xl sa) (* yl ca))
              (+ refz (* tgl t)))})
          (= {pt}  (if (== s1pt 0.) {0.} {(/ 1. (::Abs TMath s1pt))}))
          (= {col} (if (< pt 0.5) {861}
                     {(if (< pt 1.) {433}
                        {(if (< pt 2.) {418} {807})})}))
          (= {lw} 1)
          (.SetLineColor pl col)
          (.SetLineWidth pl lw)
          (.Draw pl "SAMEL")})})))

(t0 "helix-fn+draw-cylinder")

;;; ── GUI window (created before initial draws so sl is bound) ─────────────
(def {win} (new TGMainFrame (.GetRoot gClient) 460 70))

(def {hf}    (new TGHorizontalFrame win 0 0))
(def {lbl}   (new TGLabel hf "Min TPC clusters:"))
(def {sl}
  (doto (new TGHSlider hf 300 3 -1)
    {SetRange 0 160}
    {SetPosition 0}))
(def {lbl-v} (new TGLabel hf "  0"))

(.AddFrame hf lbl   (new TGLayoutHints 16 5 5 5 5))
(.AddFrame hf sl    (new TGLayoutHints 16 5 5 5 5))
(.AddFrame hf lbl-v (new TGLayoutHints 16 8 5 5 5))
(.AddFrame win hf   (new TGLayoutHints 65 5 5 8 8))

;;; ── Single canvas: 3 pads top row, 2 pads bottom row ────────────────────
(def {c} (new TCanvas "c" "ALICE track explorer" 1800 1100))

(def {pad1} (doto (new TPad "pad1" "density" 0.     0.5 0.333 1.)
  {SetRightMargin 0.16}
  {SetLeftMargin  0.12}
  {Draw}))

(def {pad2} (doto (new TPad "pad2" "scatter" 0.333  0.5 0.667 1.)
  {SetRightMargin 0.16}
  {SetLeftMargin  0.12}
  {Draw}))

(def {pad5} (doto (new TPad "pad5" "ptspec"  0.667  0.5 1.    1.)
  {SetRightMargin 0.05}
  {SetLeftMargin  0.14}
  {Draw}))

(def {pad4} (doto (new TPad "pad4" "section" 0.     0.  0.5   0.5)
  {SetRightMargin 0.16}
  {SetLeftMargin  0.13}
  {Draw}))

(def {pad3} (doto (new TPad "pad3" "helices" 0.5    0.  1.    0.5)
  {SetRightMargin 0.05}
  {SetLeftMargin  0.05}
  {Draw}))

;;; ── Helpers ──────────────────────────────────────────────────────────────

;;; pad1: projected 2-D density with nCls range cut
(def {update-density} (\{} {
  do
  (= {minCls} (.GetPosition sl))
  (.SetRange (.GetZaxis h3raw) (+ minCls 1) 162)
  (= {hp} (.Project3D h3raw "yx"))
  (.SetRange (.GetZaxis h3raw) 0 162)
  (.SetTitle hp (concat "N_{TPC cls} #geq " (str minCls) ";#varphi;#sigma(p_{T})/p_{T}"))
  (.cd pad1)
  (.Draw hp "COLZ")
  (.Update c)
  (.RaiseWindow c)
}))

;;; pad2: binned 2D density — eta × log2(sigma(pT)/pT), filtered by N_TPC cls
(def {update-scatter} (\{} {do
  (= {minCls} (.GetPosition sl))
  (.SetRange (.GetZaxis h3log) (+ minCls 1) 162)
  (= {hp} (.Project3D h3log "yx"))
  (.SetRange (.GetZaxis h3log) 0 162)
  (.SetTitle hp (concat "N_{TPC cls} #geq " (str minCls)
                        ";#eta;log_{2}(#sigma(p_{T})/p_{T})"))
  (.cd pad2)
  (.Draw hp "COLZ")
  (.Update c)
  (.RaiseWindow c)
}))

;;; pad5: distribution of per-collision mean pT for tracks passing the cluster cut.
;;; Uses mutable TArrayF/TArrayI accumulators filled via fill-accum-fn (Foreach),
;;; then build-mean-fn loops over them at native C++ speed to fill h-mean-pt.
(def {update-pt} (\{} {do
  (= {minCls} (.GetPosition sl))
  (.SetAt min-cls-box minCls 0)
  (print "update-pt: resetting arrays")
  (.Reset sum-pt-box 0.)
  (.Reset cnt-box 0)
  (print "update-pt: starting foreach")
  (-> rdf-pt
    {.Range 200000}
    {.Filter sigpt-valid-fn {"fSigma1Pt" "fSigned1Pt"}}
    {.Filter filter-fn {"fTPCNClsFindable" "fTPCNClsFindableMinusFound"}}
    {.Foreach fill-accum-fn {"fSigned1Pt" "fIndexCollisions"}})
  (print "update-pt: building histogram")
  (build-mean-fn)
  (.SetTitle h-mean-pt
    (concat "N_{TPC cls} #geq " (str minCls) ";#LT p_{T} #GT (GeV/c);Collisions"))
  (.cd pad5)
  (.SetLogy pad5 0)
  (.Draw h-mean-pt)
  (.Update c)
  (.RaiseWindow c)
}))

;;; pad4: transverse X-Y cluster density — shows the 18 TPC sectors
;;; Guide circles mark beam pipe (r=2), inner TPC wall (r=83), outer TPC wall (r=246).
(def {update-xy} (\{} {do
  (= {minCls} (.GetPosition sl))
  (.SetRange (.GetZaxis h3xy) (+ minCls 1) 162)
  (= {hp} (.Project3D h3xy "yx"))
  (.SetRange (.GetZaxis h3xy) 0 162)
  (.SetTitle hp (concat "N_{TPC cls} #geq " (str minCls) ";X (cm);Y (cm)"))
  (.cd pad4)
  (.Draw hp "COLZ")
  ;;; beam pipe
  (= {a1} (doto (new TArc 0. 0. 2.)
    {SetFillStyle 0} {SetLineColor 400} {SetLineWidth 2}))
  (.Draw a1 "SAMEL")
  ;;; inner TPC wall
  (= {a2} (doto (new TArc 0. 0. 83.)
    {SetFillStyle 0} {SetLineColor 921} {SetLineWidth 1}))
  (.Draw a2 "SAMEL")
  ;;; outer TPC wall
  (= {a3} (doto (new TArc 0. 0. 246.)
    {SetFillStyle 0} {SetLineColor 920} {SetLineWidth 1}))
  (.Draw a3 "SAMEL")
  (.Update c)
  (.RaiseWindow c)
}))

;;; draw-cylinder: wireframe cylinder in the current pad (TView must exist).
;;; r=radius, z1/z2=endcaps, nCirc=circle count, nSeg=longitudinal segments,
;;; col=ROOT colour integer, lw=line width
(def {draw-cylinder}
  (jit-fn (\{r z1 z2 nCirc nSeg col lw} {do
    (= {nc} 72)
    (= {two-pi} (* 2. (::Pi TMath)))
    ;;; circles at evenly-spaced z positions
    (dotimes {ic} nCirc {do
      (= {zc} (+ z1 (/ (* ic (- z2 z1)) (- nCirc 1))))
      (= {cir} (new TPolyLine3D (+ nc 1)))
      (dotimes {ip} (+ nc 1) {do
        (= {ph} (/ (* ip two-pi) nc))
        (.SetPoint cir ip (* r (::Cos TMath ph)) (* r (::Sin TMath ph)) zc)})
      (.SetLineColor cir col)
      (.SetLineWidth cir lw)
      (.Draw cir "SAMEL")})
    ;;; longitudinal lines
    (dotimes {ia} nSeg {do
      (= {ph} (/ (* ia two-pi) nSeg))
      (= {rx} (* r (::Cos TMath ph)))
      (= {ry} (* r (::Sin TMath ph)))
      (= {seg} (new TPolyLine3D 2))
      (.SetPoint seg 0 rx ry z1)
      (.SetPoint seg 1 rx ry z2)
      (.SetLineColor seg col)
      (.SetLineWidth seg lw)
      (.Draw seg "SAMEL")})})))

;;; pad3: true 3D helix view — uses helix-fn (jit-compiled above)
(def {update-helices} (\{} {do
  (= {minCls} (.GetPosition sl))
  (= {sw} (new TStopwatch))

  (.cd pad3)
  (.Clear pad3)
  ;;; Establish TView spanning the full TPC volume before Foreach draws anything.
  ;;; Outer TPC radius is ~246 cm, endcaps at ±250 cm — bounding box ±270.
  (= {dummy} (new TPolyLine3D 2))
  (.SetPoint dummy 0 -270. -270. -270.)
  (.SetPoint dummy 1  270.  270.  270.)
  (.SetLineColor dummy 0)
  (.Draw dummy "L")
  (.Start sw)

  ;;; Update threshold in the box — filter-fn reads it via its captured pointer.
  (.SetAt min-cls-box minCls 0)
  ;;; Limit raw entries so drawn helix count is proportional to the cut.
  (-> rdf-helix
    {.Range 500}
    {.Filter filter-fn {"fTPCNClsFindable" "fTPCNClsFindableMinusFound"}}
    {.Range 200}
    {.Foreach helix-fn helix-cols})
  (.Stop sw)
  (= {t-rdf} (.RealTime sw))

  (.Start sw)
  (draw-cylinder 2.   -250. 250. 5 12 400 2)   ;;; beam pipe        (kYellow=400)
  (draw-cylinder 83.  -250. 250. 3  8 921 1)   ;;; inner TPC wall   (kGray+1=921)
  (draw-cylinder 246. -250. 250. 3  8 920 1)   ;;; outer TPC wall   (kGray=920)
  (.Stop sw)
  (= {t-cyl} (.RealTime sw))

  (.Start sw)
  (.Update c)
  (.RaiseWindow c)
  (.Stop sw)
  (= {t-upd} (.RealTime sw))

  (print (concat "helices: rdf=" (str t-rdf) "s  cyl=" (str t-cyl) "s  update=" (str t-upd) "s"))
}))

(def {redraw} (\{} {
  do
  (update-label)
  (update-density)
  (update-scatter)
  (update-pt)
  (update-xy)
  (update-helices)
}))

;;; ── Initial draws ────────────────────────────────────────────────────────
(t0 "GUI+canvas setup")
(update-density)  (t0 "update-density")
(update-scatter)  (t0 "update-scatter")
(update-pt)       (t0 "update-pt")
(update-xy)       (t0 "update-xy")
(update-helices)  (t0 "update-helices")

;;; ── Wire slider and show window ──────────────────────────────────────────
;;; Label updates live while dragging; plots redraw only on release.
(def {update-label} (\{} {do
  (= {minCls} (.GetPosition sl))
  (.SetText lbl-v (new TGString (concat "  " (str minCls))))
  (.Layout win)}))

(connect sl "PositionChanged(Int_t)" update-label)
(connect sl "Released()" redraw)

(.SetWindowName win "TPC Cluster Cut")
(.MapSubwindows win)
(.Resize win (.GetDefaultWidth win) (.GetDefaultHeight win))
(.MapRaised win)
