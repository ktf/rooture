;;; examples/eventsel.rut
;;;
;;; Per-collision event selection flags from raw AO2D tables.
;;;
;;; Computes a subset of O2 sel8 flags:
;;;   bit 0  kIsTriggerTVX        — TVX bit set in fTriggerMask
;;;   bit 1  kNoTimeFrameBorder   — collision not at TF start/end
;;;   bit 2  kNoITSROFrameBorder  — collision not at ITS ROF border
;;;   bit 6  kIsGoodPvZ           — |pvZ| < pvz-cut cm (default 10)
;;;
;;; sel8 (bits 0–2 all pass) is also provided as a convenience mask.
;;;
;;; Usage — set parameters then load:
;;;
;;;   (def {bcSOR}      0)         ;;; first globalBC of run (REQUIRED for TF/ROF flags)
;;;   (def {nBCsPerTF}  456192)    ;;; 128 orbits * 3564 BCs/orbit  (Run 3 default)
;;;   (def {rofLength}  594)       ;;; ITS ROF length in BCs         (Run 3 default)
;;;   (def {rofOffset}  0)         ;;; ITS ROF phase offset in BCs
;;;   (def {tvx-bit}    0)         ;;; TVX bit in fTriggerMask (0 for most Run 3 data)
;;;   (def {pvz-cut}    10.0)      ;;; |pvZ| < pvz-cut cm
;;;   (load "examples/eventsel.rut")
;;;
;;; Then per time-frame:
;;;   (= {evsel} (compute-evsel-tf aod-path tf))
;;;   evsel is a list of 4 float32 columns:
;;;     {m-tvx  m-tf  m-itsrof  m-pvz}
;;;   Use (evsel-and evsel) to combine into a single AND mask.
;;;   Use (evsel-sel8 evsel) for the standard sel8 (bits 0–2 only).
;;;
;;; Limitations:
;;;   - bcSOR = 0 disables TF and ITS ROF border checks (all pass).
;;;   - kNoSameBunchPileup and kIsVertexITSTPC require Phase 3 builtins.
;;;   - kIsGoodZvtxFT0vsPV requires Phase 4 builtins (FT0 join).

;;; ── Parameter defaults ───────────────────────────────────────────────────
;;; These are set here only as a fallback. When loading from spectra_tpc.rut
;;; or another script, define these BEFORE loading eventsel.rut so the
;;; jit-fns below capture your values at compile time.
(def {bcSOR}     0)       ;;; 0 = unknown: disables TF/ROF border checks
(def {nBCsPerTF} 456192)  ;;; 128 * 3564 (Run 3 default)
(def {rofLength} 594)     ;;; ITS ROF length in BCs (Run 3)
(def {rofOffset} 0)
(def {tvx-bit}   -1)      ;;; -1 = skip TVX check; set to 0 for most Run 3 data
(def {pvz-cut}   10.0)

;;; ── Tree name defaults (override before loading for non-standard layouts) ─
(if (== bc-tree   "bc-tree")   {def {bc-tree}   "O2bc_001"}        {})
(if (== coll-tree "coll-tree") {def {coll-tree} "O2collision_001"} {})

;;; ── TF border jit-fn ─────────────────────────────────────────────────────
;;; (globalBC - bcSOR) % nBCsPerTF must be in (300, nBCsPerTF-4000)
;;; bcSOR and nBCsPerTF are constant-folded from env at jit-fn compile time.
;;; Returns 1.0 (pass) when bcSOR == 0 (unknown — skip check).
(def {tf-border-fn}
  (jit-fn float (\{{ULong64_t gbc}}
    {(if (== bcSOR 0)
      {1.0f}
      {(do
        (= {bcInTF} (rem (- gbc bcSOR) nBCsPerTF))
        (if (band (> bcInTF 300) (< bcInTF (- nBCsPerTF 4000)))
          {1.0f} {0.0f}))})})))

;;; ── ITS ROF border jit-fn ────────────────────────────────────────────────
;;; bcInROF = (globalBC + 3564 - rofOffset) % rofLength
;;; Must be in (10, rofLength-20).
;;; Returns 1.0 when bcSOR == 0 (unknown — skip check).
(def {itsrof-border-fn}
  (jit-fn float (\{{ULong64_t gbc}}
    {(if (== bcSOR 0)
      {1.0f}
      {(do
        (= {bcInROF} (rem (+ (- gbc rofOffset) 3564) rofLength))
        (if (band (> bcInROF 10) (< bcInROF (- rofLength 20)))
          {1.0f} {0.0f}))})})))

;;; ── pvZ cut jit-fn ───────────────────────────────────────────────────────
(def {pvz-ok-fn}
  (jit-fn float (\{{float pvz}}
    {(if (< (fabsf pvz) pvz-cut) {1.0f} {0.0f})})))

;;; ── resolve function pointers once ───────────────────────────────────────
(def {tf-border-ptr}    (jitfn-ptr tf-border-fn))
(def {itsrof-border-ptr}(jitfn-ptr itsrof-border-fn))
(def {pvz-ok-ptr}       (jitfn-ptr pvz-ok-fn))

;;; ── mul-fn for combining masks ───────────────────────────────────────────
(def {evsel-mul-fn}
  (jit-fn float (\{{float a} {float b}} {(* a b)})))
(def {evsel-mul-ptr} (jitfn-ptr evsel-mul-fn))

;;; ── compute-evsel-tf ─────────────────────────────────────────────────────
;;;
;;; (compute-evsel-tf aod-path tf) → {m-tvx  m-tf  m-itsrof  m-pvz  m-nopileup}
;;; Each element is a per-collision float32 column (1.0 = pass, 0.0 = fail).
;;;
;;; m-nopileup (kNoSameBunchPileup): 1.0 if collision's BC index appears
;;; exactly once in the collision table (no other collision shares the BC).
;;;
(def {compute-evsel-tf} (\{ap tf} {
  do
  ;;; BC table
  (= {bc-path}  (concat tf "/" bc-tree))
  (= {bc-gbc}   (load-branch ap bc-path "fGlobalBC"))
  (= {bc-tmask} (load-branch ap bc-path "fTriggerMask"))

  ;;; Collision table
  (= {col-path} (concat tf "/" coll-tree))
  (= {col-bidx} (load-branch ap col-path "fIndexBCs"))
  (= {col-pvz}  (load-branch ap col-path "fPosZ"))

  ;;; Per-collision BC data (index join)
  (= {c-gbc}    (col-gather bc-gbc   col-bidx))
  (= {c-tmask}  (col-gather bc-tmask col-bidx))

  ;;; Bit 0: TVX — test the TVX bit in fTriggerMask, cast bool → float
  (= {m-tvx}    (col-cast-f32 (col-test-bit c-tmask tvx-bit)))

  ;;; Bit 1: no TF border
  (= {m-tf}     (col-map-ptr tf-border-ptr     c-gbc "float"))

  ;;; Bit 2: no ITS ROF border
  (= {m-itsrof} (col-map-ptr itsrof-border-ptr c-gbc "float"))

  ;;; Bit 3: kNoSameBunchPileup — BC index must be unique in this TF
  (= {m-nopileup} (col-cast-f32 (col-unique-mask col-bidx)))

  ;;; Bit 6: |pvZ| < pvz-cut
  (= {m-pvz}    (col-map-ptr pvz-ok-ptr col-pvz))

  (list m-tvx m-tf m-itsrof m-pvz m-nopileup)
}))

;;; ── evsel-and : combine all 5 flags into one AND mask ────────────────────
(def {evsel-and} (\{flags} {
  do
  (= {m} (nth 0 flags))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 1 flags)))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 2 flags)))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 3 flags)))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 4 flags)))
  m
}))

;;; ── evsel-sel8 : bits 0–3 (TVX + TF border + ITS ROF + no-pileup) ───────
(def {evsel-sel8} (\{flags} {
  do
  (= {m} (nth 0 flags))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 1 flags)))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 2 flags)))
  (= {m} (col-zip-ptr evsel-mul-ptr m (nth 4 flags)))
  m
}))

(print "eventsel.rut loaded."
  "bcSOR=" bcSOR
  "nBCsPerTF=" nBCsPerTF
  "rofLength=" rofLength
  "tvx-bit=" tvx-bit
  "pvz-cut=" pvz-cut
  "bc-tree=" bc-tree
  "coll-tree=" coll-tree)
