;;; examples/raa_pbpb.rut
;;; Centrality-differential charged hadron pT spectra in Pb-Pb at 5.02 TeV.
;;;
;;; Prerequisites — must be set before loading:
;;;   aod-paths, trk-tree, extra-tree, coll-tree, bc-tree,
;;;   its-map-branch, bz
;;;   quality-cut jit-fn pointers: eta-ok-ptr, cls-ok-ptr, its-ok-ptr,
;;;   tpcchi2-ok-ptr, crows-ok-ptr, dca-ok-ptr, sub-ptr, pt-ptr
;;;   propagate-to-dca col-jit-fn
;;;   compute-evsel-tf, evsel-and (from eventsel.rut)
;;; All of the above are defined by spectra_tpc.rut / run_opendata_lhc15o.rut.
;;; If loading standalone, load eventsel.rut + spectra_tpc.rut first.

(def {cent-tree} "O2centrun2v0m")

;;; ── Centrality class masks ────────────────────────────────────────────────
;;; Four classes with float32 literal bounds (no constant-folding needed).
(def {cent0-ptr} (jitfn! "cent0"  float (\{{float c}} {(if (>= c  0.0f) {(if (< c 10.0f) {1.0f} {0.0f})} {0.0f})})))
(def {cent1-ptr} (jitfn! "cent1"  float (\{{float c}} {(if (>= c 10.0f) {(if (< c 30.0f) {1.0f} {0.0f})} {0.0f})})))
(def {cent2-ptr} (jitfn! "cent2"  float (\{{float c}} {(if (>= c 30.0f) {(if (< c 50.0f) {1.0f} {0.0f})} {0.0f})})))
(def {cent3-ptr} (jitfn! "cent3"  float (\{{float c}} {(if (>= c 50.0f) {(if (< c 80.0f) {1.0f} {0.0f})} {0.0f})})))

;;; ── N_coll (ALICE Glauber, Pb-Pb 5.02 TeV, V0M, approximate) ────────────
(def {ncoll-c0} 1502.0)   ; 0-10%
(def {ncoll-c1}  724.0)   ; 10-30%
(def {ncoll-c2}  295.0)   ; 30-50%
(def {ncoll-c3}   75.6)   ; 50-80% (peripheral reference)

;;; Helper: map any float column to 1.0 (event counting)
(def {ones-ptr} (jitfn! "ones" float (\{{float x}} {1.0f})))

;;; ── Histograms ───────────────────────────────────────────────────────────
(def {h-pt-c0} (doto (new TH1F "hpt_c0" "0-10%;p_{T} (GeV/c);Tracks"   100 0. 10.) {SetDirectory 0}))
(def {h-pt-c1} (doto (new TH1F "hpt_c1" "10-30%;p_{T} (GeV/c);Tracks"  100 0. 10.) {SetDirectory 0}))
(def {h-pt-c2} (doto (new TH1F "hpt_c2" "30-50%;p_{T} (GeV/c);Tracks"  100 0. 10.) {SetDirectory 0}))
(def {h-pt-c3} (doto (new TH1F "hpt_c3" "50-80%;p_{T} (GeV/c);Tracks"  100 0. 10.) {SetDirectory 0}))

;;; Event counters: 1-bin histograms [0,2], fill with 1.0 per passing collision
(def {h-nev-c0} (doto (new TH1F "hnev_c0" "" 1 0. 2.) {SetDirectory 0}))
(def {h-nev-c1} (doto (new TH1F "hnev_c1" "" 1 0. 2.) {SetDirectory 0}))
(def {h-nev-c2} (doto (new TH1F "hnev_c2" "" 1 0. 2.) {SetDirectory 0}))
(def {h-nev-c3} (doto (new TH1F "hnev_c3" "" 1 0. 2.) {SetDirectory 0}))

;;; ── Live spectra canvas — shown before loop, updated every 10 TFs ─────────
(def {c-cent} (doto (new TCanvas "c_cent" "Pb-Pb centrality spectra" 900 700) {SetLogy}))
(doto h-pt-c0 {SetTitle ";p_{T} (GeV/c);Tracks (accumulating)"}
              {SetStats 0} {SetLineColor 2} {SetLineWidth 2} {Draw "HIST"})
(doto h-pt-c1 {SetLineColor 4} {SetLineWidth 2} {Draw "HIST SAME"})
(doto h-pt-c2 {SetLineColor 6} {SetLineWidth 2} {Draw "HIST SAME"})
(doto h-pt-c3 {SetLineColor 8} {SetLineWidth 2} {Draw "HIST SAME"})
(def {leg-cent} (doto (new TLegend 0.55 0.65 0.88 0.88) {SetBorderSize 0}))
(.AddEntry leg-cent h-pt-c0 "0-10%"  "L")
(.AddEntry leg-cent h-pt-c1 "10-30%" "L")
(.AddEntry leg-cent h-pt-c2 "30-50%" "L")
(.AddEntry leg-cent h-pt-c3 "50-80%" "L")
(.Draw leg-cent)
(.Update c-cent)

;;; ── Main loop — per-file, TFs discovered on the fly ──────────────────────
(def {tf-seq} 0)   ;;; global TF counter for live-update modulo
(dotimes {fi} (len aod-paths) {
  do
  (= {aod-path} (nth fi aod-paths))
  (print "File" (+ fi 1) "/" (len aod-paths) aod-path)
  (= {fh} (::Open TFile aod-path))
  (if (== fh 0) {print "WARNING: skipping" aod-path} {
    if (.IsZombie fh) {print "WARNING: zombie" aod-path} {
      do
      (= {fkeys} (.GetListOfKeys fh))
      (dotimes {ki} (.GetEntries fkeys) {
        do
        (= {fk} (.At fkeys ki))
        (if (== (.GetClassName fk) "TDirectoryFile") {
          do
          (= {tf} (.GetName fk))
          (print "  TF" tf)
          (= {tf-seq} (+ tf-seq 1))

  ;;; track parameters
  (= {fx-c}   (load-branch aod-path (concat tf "/" trk-tree) "fX"))
  (= {fy-c}   (load-branch aod-path (concat tf "/" trk-tree) "fY"))
  (= {fz-c}   (load-branch aod-path (concat tf "/" trk-tree) "fZ"))
  (= {snp-c}  (load-branch aod-path (concat tf "/" trk-tree) "fSnp"))
  (= {tgl-c}  (load-branch aod-path (concat tf "/" trk-tree) "fTgl"))
  (= {q1pt-c} (load-branch aod-path (concat tf "/" trk-tree) "fSigned1Pt"))
  (= {alp-c}  (load-branch aod-path (concat tf "/" trk-tree) "fAlpha"))
  (= {cidx-c} (load-branch aod-path (concat tf "/" trk-tree) "fIndexCollisions"))

  ;;; track quality branches
  (= {find-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindable"))
  (= {fmin-c}    (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindableMinusFound"))
  (= {fcrows-c}  (load-branch aod-path (concat tf "/" extra-tree) "fTPCNClsFindableMinusCrossedRows"))
  (= {itsmap-c}  (load-branch aod-path (concat tf "/" extra-tree) its-map-branch))
  (= {itschi2-c} (load-branch aod-path (concat tf "/" extra-tree) "fITSChi2NCl"))
  (= {tpcchi2-c} (load-branch aod-path (concat tf "/" extra-tree) "fTPCChi2NCl"))

  ;;; collision vertex + event selection (reuses compute-evsel-tf from eventsel.rut)
  (= {pvxc-c}     (load-branch aod-path (concat tf "/" coll-tree) "fPosX"))
  (= {pvyc-c}     (load-branch aod-path (concat tf "/" coll-tree) "fPosY"))
  (= {pvzc-c}     (load-branch aod-path (concat tf "/" coll-tree) "fPosZ"))
  (= {evsel-cols} (compute-evsel-tf aod-path tf))
  (= {evsel-col}  (evsel-and evsel-cols))

  ;;; centrality per collision
  (= {cent-c} (load-branch aod-path (concat tf "/" cent-tree) "fCentRun2V0M"))

  ;;; count events per centrality class (collision-level, evsel applied)
  (= {ones-col} (col-map-ptr ones-ptr cent-c))
  (col-fill-h1 h-nev-c0 (col-mask (col-and evsel-col (col-map-ptr cent0-ptr cent-c)) ones-col))
  (col-fill-h1 h-nev-c1 (col-mask (col-and evsel-col (col-map-ptr cent1-ptr cent-c)) ones-col))
  (col-fill-h1 h-nev-c2 (col-mask (col-and evsel-col (col-map-ptr cent2-ptr cent-c)) ones-col))
  (col-fill-h1 h-nev-c3 (col-mask (col-and evsel-col (col-map-ptr cent3-ptr cent-c)) ones-col))

  ;;; gather collision-level quantities to per-track
  (= {pvX-c}    (col-gather pvxc-c    cidx-c))
  (= {pvY-c}    (col-gather pvyc-c    cidx-c))
  (= {pvZ-c}    (col-gather pvzc-c    cidx-c))
  (= {m-ev}     (col-gather evsel-col cidx-c))
  (= {cent-trk} (col-gather cent-c    cidx-c))

  ;;; DCA propagation (reuses propagate-to-dca from spectra_tpc.rut)
  (= {dca}    (propagate-to-dca fx-c fy-c fz-c snp-c tgl-c q1pt-c alp-c pvX-c pvY-c pvZ-c))
  (= {dcaxy-c}(nth 0 dca))
  (= {dcaz-c} (nth 1 dca))

  ;;; derived columns
  (= {ncls-c}   (col-zip-ptr sub-ptr (col-cast-f32 find-c) (col-cast-f32 fmin-c)))
  (= {ncrows-c} (col-zip-ptr sub-ptr (col-cast-f32 find-c) (col-cast-f32 fcrows-c)))
  (= {pt-c}     (col-map-ptr pt-ptr q1pt-c))

  ;;; quality mask: event sel + eta + nCls + DCA + global track cuts
  (= {m-qual}
    (col-and m-ev
             (col-map-ptr eta-ok-ptr tgl-c)
             (col-map-ptr cls-ok-ptr ncls-c)
             (col-zip-ptr dca-ok-ptr dcaxy-c dcaz-c pt-c)
             (col-zip-ptr its-ok-ptr (col-cast-f32 itsmap-c) (col-cast-f32 itschi2-c))
             (col-map-ptr tpcchi2-ok-ptr (col-cast-f32 tpcchi2-c))
             (col-zip-ptr crows-ok-ptr ncrows-c (col-cast-f32 find-c))))

  ;;; centrality masks × quality mask
  (= {m-c0} (col-and m-qual (col-map-ptr cent0-ptr cent-trk)))
  (= {m-c1} (col-and m-qual (col-map-ptr cent1-ptr cent-trk)))
  (= {m-c2} (col-and m-qual (col-map-ptr cent2-ptr cent-trk)))
  (= {m-c3} (col-and m-qual (col-map-ptr cent3-ptr cent-trk)))

  (col-fill-h1 h-pt-c0 (col-mask m-c0 pt-c))
  (col-fill-h1 h-pt-c1 (col-mask m-c1 pt-c))
  (col-fill-h1 h-pt-c2 (col-mask m-c2 pt-c))
  (col-fill-h1 h-pt-c3 (col-mask m-c3 pt-c))

          ;;; live update every TF
          (.SetTitle c-cent (concat "Pb-Pb | File " (str (+ fi 1)) "/" (str (len aod-paths)) " | TF " (str tf-seq)))
          (.Update c-cent)
          (.RaiseWindow c-cent)
          (.ProcessEvents gSystem)
        } {})
      })
      (close-cached-files)
    }}
  )
})

;;; ── R_CP ─────────────────────────────────────────────────────────────────
(def {nev-c0} (.GetBinContent h-nev-c0 1))
(def {nev-c1} (.GetBinContent h-nev-c1 1))
(def {nev-c2} (.GetBinContent h-nev-c2 1))
(def {nev-c3} (.GetBinContent h-nev-c3 1))
(print "Events — 0-10%:" nev-c0 " 10-30%:" nev-c1 " 30-50%:" nev-c2 " 50-80%:" nev-c3)

(if (> (* nev-c0 nev-c1 nev-c2 nev-c3) 0.) {
  do

  ;;; R_CP(cent) = (Ncoll_periph/Ncoll_cent) × (N_cent/Nev_cent) / (N_periph/Nev_periph)
  ;;;            = (Ncoll_periph/Ncoll_cent) × (Nev_periph/Nev_cent) × h_cent / h_periph
  (def {h-rcp-c0} (.Clone h-pt-c0 "h_rcp_c0"))
  (.Divide h-rcp-c0 h-pt-c3)
  (.Scale  h-rcp-c0 (* (/ nev-c3 nev-c0) (/ ncoll-c3 ncoll-c0)))
  (.SetTitle h-rcp-c0 "R_{CP} (50-80% reference);p_{T} (GeV/c);R_{CP}")

  (def {h-rcp-c1} (.Clone h-pt-c1 "h_rcp_c1"))
  (.Divide h-rcp-c1 h-pt-c3)
  (.Scale  h-rcp-c1 (* (/ nev-c3 nev-c1) (/ ncoll-c3 ncoll-c1)))

  (def {h-rcp-c2} (.Clone h-pt-c2 "h_rcp_c2"))
  (.Divide h-rcp-c2 h-pt-c3)
  (.Scale  h-rcp-c2 (* (/ nev-c3 nev-c2) (/ ncoll-c3 ncoll-c2)))

  ;;; reference line at unity
  (def {rcp-line} (doto (new TLine 0. 1. 9. 1.) {SetLineStyle 2} {SetLineColor 1}))

  ;;; Finalize spectra canvas (per-event normalised)
  (.Scale h-pt-c0 (/ 1.0 nev-c0))
  (.Scale h-pt-c1 (/ 1.0 nev-c1))
  (.Scale h-pt-c2 (/ 1.0 nev-c2))
  (.Scale h-pt-c3 (/ 1.0 nev-c3))
  (doto h-pt-c0 {SetTitle ";p_{T} (GeV/c);(1/N_{ev}) dN/dp_{T}"})
  (.Update c-cent)

  ;;; Draw R_CP
  (def {c-rcp} (new TCanvas "c_rcp" "R_{CP} Pb-Pb 5.02 TeV" 900 700))
  (doto h-rcp-c0 {SetStats 0} {SetLineColor 2} {SetLineWidth 2}
                 {SetMinimum 0.} {SetMaximum 1.1} {Draw "HIST"})
  (.SetRangeUser (.GetXaxis h-rcp-c0) 0. 9.)
  (doto h-rcp-c1 {SetLineColor 4} {SetLineWidth 2} {Draw "HIST SAME"})
  (doto h-rcp-c2 {SetLineColor 6} {SetLineWidth 2} {Draw "HIST SAME"})
  (.Draw rcp-line "SAME")
  (def {leg-rcp} (doto (new TLegend 0.55 0.70 0.88 0.88) {SetBorderSize 0}))
  (.AddEntry leg-rcp h-rcp-c0 "0-10% / 50-80%"  "L")
  (.AddEntry leg-rcp h-rcp-c1 "10-30% / 50-80%" "L")
  (.AddEntry leg-rcp h-rcp-c2 "30-50% / 50-80%" "L")
  (.Draw leg-rcp)
  (.Update c-rcp)
} {
  print "WARNING: no events in one or more centrality classes — skipping R_CP (check EOS access)"
})
